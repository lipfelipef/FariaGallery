---
import '../styles/global.css';
import { SITE, SOCIAL, type Locale } from '../consts';
import { traduzir } from '../i18n/ui';
import { LANG_HTML, rota } from '../i18n/utils';
import { destinosPorIdioma } from '../lib/idiomas';

interface Props {
  lang: Locale;
  /** Vai antes do nome. Deixe vazio na home, onde o título abre com o domínio. */
  titulo?: string;
  descricao: string;
  /** Página sem conteúdo ainda não deve entrar na busca. */
  semIndexar?: boolean;
}

const { lang, titulo, descricao, semIndexar = false } = Astro.props;
const t = traduzir(lang);

/** Todo título termina no nome, que é o que faz ele aparecer na busca. */
const tituloDaAba = titulo
  ? `${titulo} | ${SITE.name}`
  : `${SITE.domain} | ${SITE.name}`;

const canonica = new URL(Astro.url.pathname, SITE.url).href;
const cartao = new URL('/card.png', SITE.url).href;

/**
 * Só entra no hreflang o idioma que tem ESTA página de verdade. Anunciar
 * uma tradução que não existe é dizer ao buscador que duas páginas
 * diferentes são a mesma coisa, e ele penaliza por isso.
 */
const idiomas = (await destinosPorIdioma(Astro.url)).filter((alt) => alt.exata);

const pessoa = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  image: new URL('/apple-touch-icon.png', SITE.url).href,
  jobTitle: 'Desenvolvedor',
  nationality: 'Brasileiro',
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Centro Universitário Senac',
    department: { '@type': 'CollegeOrUniversity', name: 'Santo Amaro' },
  },
  knowsAbout: ['Desenvolvimento web', 'Angular', 'Node.js', 'Java', 'Python'],
  sameAs: SOCIAL.map((s) => s.href),
};
---

<!doctype html>
<html lang={LANG_HTML[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloDaAba}</title>
    <meta name="description" content={descricao} />
    {semIndexar && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonica} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={rota(lang, '/rss.xml').replace(/\/$/, '')} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      idiomas.length > 1 &&
        idiomas.map((alt) => (
          <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.href, SITE.url).href} />
        ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', SITE.url).href} />

    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={LANG_HTML[lang].replace('-', '_')} />
    <meta property="og:title" content={tituloDaAba} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={cartao} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}, ${SITE.domain}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={cartao} />

    <meta name="theme-color" content="#fbfbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141416" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Roda antes da página pintar. Sem isso a sala clara pisca por um
      instante antes de virar escura, que é o defeito mais comum de
      site com tema. Guarda a escolha em localStorage, que é preferência
      de quem visita, não rastreio: não sai do navegador da pessoa.
    -->
    <script is:inline>
      (function () {
        try {
          var salvo = localStorage.getItem('tema');
          var escuro =
            salvo === 'escuro' ||
            (!salvo && matchMedia('(prefers-color-scheme: dark)').matches);
          if (escuro) document.documentElement.setAttribute('data-tema', 'escuro');
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(pessoa)} />
  </head>

  <body>
    <a class="pular" href="#conteudo">{t('pular')}</a>
    <slot />
  </body>
</html>

<style>
  .pular {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 10;
    background: var(--color-ink);
    color: var(--color-wall);
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
  }

  .pular:focus {
    left: 0;
  }
</style>
