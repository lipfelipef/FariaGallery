---
import '../styles/global.css';
import { SITE, PERFIS, type Locale } from '../consts';
import { traduzir } from '../i18n/ui';
import { LANG_HTML, OG_LOCALE, rota } from '../i18n/utils';
import { destinosPorIdioma } from '../lib/idiomas';

interface Props {
  lang: Locale;
  /** Vai antes do nome. Deixe vazio na home, onde o título abre com o domínio. */
  titulo?: string;
  descricao: string;
  /** Página sem conteúdo ainda não deve entrar na busca. */
  semIndexar?: boolean;
  /**
   * Preenchido só em post. Sem isto, o buscador vê a página como um site
   * qualquer e não sabe que é texto com autor, data e assunto, que é o que
   * habilita a página a aparecer como artigo no resultado.
   */
  artigo?: {
    titulo: string;
    publicado: Date;
    atualizado?: Date;
    assuntos: readonly string[];
  };
}

const { lang, titulo, descricao, semIndexar = false, artigo } = Astro.props;
const t = traduzir(lang);

/** Todo título termina no nome, que é o que faz ele aparecer na busca. */
const tituloDaAba = titulo
  ? `${titulo} | ${SITE.name}`
  : `${SITE.domain} | ${SITE.name}`;

const canonica = new URL(Astro.url.pathname, SITE.url).href;
const cartao = new URL('/card.png', SITE.url).href;

/**
 * Só entra no hreflang o idioma que tem ESTA página de verdade. Anunciar
 * uma tradução que não existe é dizer ao buscador que duas páginas
 * diferentes são a mesma coisa, e ele penaliza por isso.
 *
 * Página fora da busca não anuncia alternativa nenhuma. Vale para a de erro,
 * cujo seletor de idioma leva à entrada de cada idioma: sem esta linha, o
 * hreflang dela diria que a página de erro é a versão em outro idioma da
 * home, que é justamente a confusão que o hreflang existe para evitar.
 */
const idiomas = semIndexar ? [] : (await destinosPorIdioma(Astro.url)).filter((alt) => alt.exata);

/**
 * Schema.org do artigo. Declara autor, data de publicação, idioma e assunto,
 * e amarra o texto à mesma pessoa do outro bloco pelo `@id`, para o buscador
 * entender que é o mesmo Felipe e não dois homônimos.
 */
const artigoSchema = artigo && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: artigo.titulo,
  description: descricao,
  datePublished: artigo.publicado.toISOString(),
  dateModified: (artigo.atualizado ?? artigo.publicado).toISOString(),
  inLanguage: LANG_HTML[lang],
  keywords: artigo.assuntos.join(', '),
  image: cartao,
  author: { '@id': `${SITE.url}#pessoa` },
  publisher: { '@id': `${SITE.url}#pessoa` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonica },
  isPartOf: { '@type': 'Blog', name: `${SITE.name}, blog`, url: new URL(rota(lang, '/blog'), SITE.url).href },
};

/**
 * Serializa o Schema.org de um jeito que não pode fechar a própria tag.
 *
 * `JSON.stringify` não escapa `<`, então um título de post que contivesse
 * `</script>` sairia literal no meio do bloco, fechava a tag ali e o resto
 * virava HTML executável. Hoje todo o conteúdo do site é escrito por ele, em
 * arquivo, e ninguém de fora escreve nada aqui, então isso não é uma porta
 * aberta: é uma porta que nunca deve chegar a existir. Trocar o `<` pelo
 * escape unicode custa nada e fecha a classe inteira do problema, inclusive
 * no dia em que o texto vier de outro lugar.
 */
const emScript = (dados: unknown) => JSON.stringify(dados).replace(/</g, '\\u003c');

const pessoa = {
  '@id': `${SITE.url}#pessoa`,
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  url: SITE.url,
  image: new URL('/apple-touch-icon.png', SITE.url).href,
  jobTitle: 'Desenvolvedor',
  nationality: 'Brasileiro',
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Centro Universitário Senac',
    department: { '@type': 'CollegeOrUniversity', name: 'Santo Amaro' },
  },
  knowsAbout: ['Desenvolvimento web', 'Angular', 'Node.js', 'Java', 'Python'],
  sameAs: PERFIS,
};
---

<!doctype html>
<!--
  A galeria abre na sala escura, sempre.

  O atributo ja vem escrito aqui, e nao posto pelo script, para o site nascer
  escuro tambem para quem esta sem JavaScript e para quem tem o sistema no
  claro. Quem escolher a sala clara dentro do site tem a escolha guardada, e o
  script logo abaixo desfaz este atributo antes da pagina pintar.
-->
<html lang={LANG_HTML[lang]} data-tema="escuro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloDaAba}</title>
    <meta name="description" content={descricao} />
    {semIndexar && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonica} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={rota(lang, '/rss.xml').replace(/\/$/, '')} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      idiomas.length > 1 && (
        <>
          {idiomas.map((alt) => (
            <link rel="alternate" hreflang={alt.hreflang} href={new URL(alt.href, SITE.url).href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL('/', SITE.url).href} />
        </>
      )
    }

    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <!-- O maior existe para a busca do Google, que pede quadrado e recomenda
         acima de 48px. Ela rastreia o ícone à parte da página, e o que sai no
         resultado é este. -->
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- /favicon.ico existe na raiz como reserva. Navegador antigo e alguns
         robôs pedem esse caminho direto, sem ler as declarações acima. -->

    <meta name="author" content={SITE.name} />
    <meta property="og:type" content={artigo ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    {
      artigo && (
        <>
          <meta property="article:author" content={SITE.name} />
          <meta property="article:published_time" content={artigo.publicado.toISOString()} />
          <meta
            property="article:modified_time"
            content={(artigo.atualizado ?? artigo.publicado).toISOString()}
          />
          {artigo.assuntos.map((a) => <meta property="article:tag" content={a} />)}
        </>
      )
    }
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:title" content={tituloDaAba} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={cartao} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}, ${SITE.domain}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={cartao} />

    <!--
      Um só, sem `media`, e escuro: é a cor da sala em que o site abre. Antes
      eram dois, escolhidos pelo tema do sistema, e nenhum acompanhava a troca
      dentro do site, porque o botão do topo procura justamente o meta sem
      `media` e não achava nenhum. Agora acha, e a barra do navegador vira
      junto com a parede.
    -->
    <meta name="theme-color" content="#141416" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Roda antes da página pintar, e só desfaz.

      A sala escura é o padrão da casa e já vem escrita no `<html>`. Aqui
      cuidamos do caso contrário: quem trocou para a sala clara tem a escolha
      guardada e ela precisa valer antes do primeiro quadro, senão o escuro
      pisca na cara de quem pediu claro.

      `localStorage` é preferência de quem visita, não rastreio: não sai do
      navegador da pessoa e não vira cookie nem chamada de rede.
    -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('tema') === 'claro') {
            document.documentElement.removeAttribute('data-tema');
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', '#fbfbf9');
          }
        } catch (e) {}
      })();
    </script>

    <script type="application/ld+json" is:inline set:html={emScript(pessoa)} />
    {
      artigoSchema && (
        <script type="application/ld+json" is:inline set:html={emScript(artigoSchema)} />
      )
    }
  </head>

  <body>
    <a class="pular" href="#conteudo">{t('pular')}</a>
    <slot />
  </body>
</html>

<style>
  .pular {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 10;
    background: var(--color-ink);
    color: var(--color-wall);
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
  }

  .pular:focus {
    left: 0;
  }
</style>
