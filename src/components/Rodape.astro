---
import { REPO, type Locale } from '../consts';
import { traduzir } from '../i18n/ui';
import { anoAtual } from '../lib/tempo';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = traduzir(lang);
/** No fuso de São Paulo, e não no da máquina que compila. Ver `anoAtual`. */
const ano = anoAtual();
---

<!--
  Um bloco só. O colofão de museu já é o lugar de dizer como a coisa foi
  feita e de quem é, então privacidade, licença e direitos entram na mesma
  nota em vez de virarem um segundo rodapé.
-->
<footer class="rodape wall hang">
  <p class="field">{t('campo.colofao')}</p>
  <div class="nota">
    <p>{t('colofao')}</p>
    <p class="linhas">
      {t('rodape.privacidade').map((linha) => <span>{linha}</span>)}
    </p>
    <p>
      <a class="quiet-link" href={REPO} rel="noopener noreferrer" target="_blank">
        {t('rodape.codigo')}
      </a>
    </p>
    <p class="direitos linhas">
      {t('rodape.direitos')(ano).map((linha) => <span>{linha}</span>)}
    </p>
  </div>
</footer>

<!--
  O ano da nota de direitos se corrige sozinho.

  O site é estático, então o que vale é o ano do último build. Sem isto, um
  site publicado em 2026 e deixado quieto continuaria dizendo 2026 em 2027.
  O ano é lido no fuso de São Paulo, igual ao do servidor.
-->
<script is:inline define:vars={{ fuso: 'America/Sao_Paulo', anoDoBuild: ano }}>
  (function () {
    var el = document.querySelector('.direitos span');
    if (!el) return;
    var agora = Number(
      new Intl.DateTimeFormat('en-CA', { year: 'numeric', timeZone: fuso }).format(new Date())
    );
    if (agora !== anoDoBuild) {
      el.textContent = el.textContent.replace(String(anoDoBuild), String(agora));
    }
  })();
</script>

<style>
  .rodape {
    padding-block: clamp(3rem, 8vh, 5rem) clamp(3rem, 8vh, 4rem);
    border-top: 1px solid var(--color-rule);
  }

  .nota p {
    font-size: 0.75rem;
    line-height: 1.65;
    color: var(--color-ink-soft);
    max-width: 62ch;
  }

  /* A autoria numa linha, a reserva de direitos noutra. A quebra vem da
     classe `linhas`, no global.css. */

  .nota p + p {
    margin-top: 0.6rem;
  }

  @media (max-width: 47.99rem) {
    .rodape .field {
      margin-top: 0;
      margin-bottom: 1rem;
    }
  }
</style>
