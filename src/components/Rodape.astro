---
import { SITE } from '../consts';

const ano = new Date().getFullYear();
---

<footer class="rodape wall hang">
  <p class="field">Colofão</p>
  <div>
    <p class="colofao">
      Feito em Astro. Composto em Archivo e EB Garamond. Sem cookie, sem
      rastreio e sem formulário.
    </p>
    <p class="assinatura">{SITE.name}, {ano}</p>
  </div>
</footer>

<style>
  .rodape {
    padding-block: clamp(3rem, 8vh, 5rem) clamp(4rem, 10vh, 6rem);
    border-top: 1px solid var(--color-rule);
  }

  .colofao {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 40ch;
  }

  .assinatura {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 47.99rem) {
    .rodape .field {
      margin-top: 0;
      margin-bottom: 1rem;
    }
  }
</style>
