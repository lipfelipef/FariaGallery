---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import Topo from './Topo.astro';
import Rodape from './Rodape.astro';
import { CONTACT_EMAIL, EMAIL_ATIVO, CURRICULO, type Locale } from '../consts';
import { traduzir } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = traduzir(lang);

/**
 * O botão do currículo só aparece se o PDF existir mesmo em public/.
 *
 * Usa `process.cwd()` e não `import.meta.url`: no build o componente vira
 * um pedaço empacotado e a URL do módulo deixa de apontar para o arquivo
 * original, então o teste dava sempre falso.
 */
const temCurriculo = existsSync(join(process.cwd(), 'public', CURRICULO));
---

<Base lang={lang} titulo={t('contato.titulo')} descricao={t('contato.chamada')}>
  <Topo lang={lang} />

  <main id="conteudo">
    <section class="abertura wall hang">
      <div class="abertura-corpo">
        <h1 class="titulo-sala">{t('contato.titulo')}</h1>
        <p class="chamada">{t('contato.chamada')}</p>
      </div>
    </section>

    <section class="wall">
      <div class="corpo">
        {
          EMAIL_ATIVO && (
            <dl class="canal hang">
              <dt class="field">{t('contato.email')}</dt>
              <dd class="endereco">
                <a class="quiet-link" href={`mailto:${CONTACT_EMAIL}`}>
                  {CONTACT_EMAIL}
                </a>
              </dd>
            </dl>
          )
        }

        {
          temCurriculo && (
            <div class="curriculo hang">
              <span />
              <a class="botao" href={CURRICULO} download>
                <span>{t('link.curriculo')}</span>
                <span class="botao-seta" aria-hidden="true">
                  &#8595;
                </span>
              </a>
            </div>
          )
        }
      </div>
    </section>
  </main>

  <Rodape lang={lang} />
</Base>

<style>
  .abertura {
    padding-block: clamp(3rem, 10vh, 6rem) clamp(2rem, 6vh, 3.5rem);
  }

  .abertura-corpo {
    grid-column: 2 / -1;
  }

  @media (max-width: 47.99rem) {
    .abertura-corpo {
      grid-column: 1 / -1;
    }
  }

  .titulo-sala {
    font-size: clamp(2rem, 1.2rem + 3vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .chamada {
    margin-top: 1rem;
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .corpo {
    border-top: 1px solid var(--color-rule);
  }

  .canal {
    padding-block: clamp(2.5rem, 5vw, 3.5rem) 0;
    row-gap: 0.5rem;
  }

  /* Sendo o único canal da página, o endereço não é legenda: é o conteúdo.
     Por isso vem no corpo do texto e não no tamanho de ficha. */
  .endereco {
    font-size: clamp(1.125rem, 0.9rem + 0.9vw, 1.5rem);
    line-height: 1.4;
  }

  .curriculo {
    padding-block: 2.5rem clamp(3rem, 8vh, 5rem);
  }

  /* Botão de verdade, não link de texto: currículo é a ação que o
     recrutador procura, e precisa de alvo grande e contorno visível.
     Inverte no hover em vez de acender uma cor que não existe no site. */
  .botao {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    border: 1px solid var(--color-ink);
    padding: 0.85rem 1.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .botao:hover {
    background-color: var(--color-ink);
    color: var(--color-wall);
  }

  .botao-seta {
    font-size: 0.875rem;
    transition: transform 180ms ease;
  }

  .botao:hover .botao-seta {
    transform: translateY(2px);
  }
</style>
