---
import Base from '../layouts/Base.astro';
import Topo from './Topo.astro';
import Rodape from './Rodape.astro';
import { CONTACT_EMAIL, EMAIL_ATIVO, type Locale } from '../consts';
import { traduzir } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = traduzir(lang);
---

<Base lang={lang} titulo={t('contato.titulo')} descricao={t('meta.contato')}>
  <Topo lang={lang} />

  <main id="conteudo">
    <section class="abertura wall hang">
      <div class="abertura-corpo">
        <h1 class="titulo-sala">{t('contato.titulo')}</h1>
        <p class="chamada linhas">
          {t('contato.chamada').map((linha) => <span>{linha}</span>)}
        </p>
      </div>
    </section>

    <section class="wall">
      <div class="corpo">
        {
          EMAIL_ATIVO && (
            <dl class="canal hang">
              <dt class="field">{t('contato.email')}</dt>
              <dd class="endereco">
                <a class="quiet-link" href={`mailto:${CONTACT_EMAIL}`}>
                  {CONTACT_EMAIL}
                </a>
              </dd>
            </dl>
          )
        }

        <dl class="ficha hang">
          <dt class="field">{t('contato.local')}</dt>
          <dd class="value">{t('contato.localValor')}</dd>
          <dt class="field">{t('contato.responde')}</dt>
          <dd class="value">{t('contato.respondeValor')}</dd>
        </dl>

        <p class="nota hang">
          <span></span>
          <span class="nota-texto linhas">
            {t('contato.nota').map((linha) => <span>{linha}</span>)}
          </span>
        </p>
      </div>
    </section>
  </main>

  <Rodape lang={lang} />
</Base>

<style>
  .abertura {
    padding-block: clamp(3rem, 10vh, 6rem) clamp(2rem, 6vh, 3.5rem);
  }

  .abertura-corpo {
    grid-column: 2 / -1;
  }

  @media (max-width: 47.99rem) {
    .abertura-corpo {
      grid-column: 1 / -1;
    }
  }

  .titulo-sala {
    font-size: clamp(2rem, 1.2rem + 3vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .chamada {
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  /* A quebra vem da classe `linhas`; aqui só a medida do desktop. */
  .chamada span {
    max-width: 68ch;
  }

  .corpo {
    border-top: 1px solid var(--color-rule);
  }

  .canal {
    padding-block: clamp(2.5rem, 5vw, 3.5rem) 0;
    row-gap: 0.5rem;
  }

  /* Sendo o único canal da página, o endereço não é legenda: é o conteúdo.
     Por isso vem no corpo do texto e não no tamanho de ficha. */
  .endereco {
    font-size: clamp(1.125rem, 0.9rem + 0.9vw, 1.5rem);
    line-height: 1.4;
  }

  .ficha {
    padding-block: clamp(2rem, 4vw, 2.5rem) 0;
    row-gap: 0.5rem;
  }

  @media (max-width: 47.99rem) {
    .ficha {
      row-gap: 0.125rem;
    }
  }

  /* A nota fica separada por um fio: é orientação, não dado da ficha.

     Ela também fecha a página, e o espaço de baixo é o que impede o texto de
     encostar no fio do rodapé: sem ele o de cima ficava com 41px e o de baixo
     com nenhum, e era isso que fazia o texto parecer grudado na linha. */
  .nota {
    margin-top: clamp(2rem, 4vw, 2.5rem);
    padding-top: clamp(2rem, 4vw, 2.5rem);
    padding-bottom: clamp(3rem, 8vh, 5rem);
    border-top: 1px solid var(--color-rule);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  /* A quebra vem da classe `linhas`. A medida comporta a linha mais longa dos
     três idiomas, que é a do espanhol. */
  .nota-texto span {
    max-width: 92ch;
  }
</style>
