---
import Base from '../layouts/Base.astro';
import Topo from './Topo.astro';
import Rodape from './Rodape.astro';
import { LIMITE_FILTROS, FOLGA_FILTROS, type Locale } from '../consts';
import { traduzir } from '../i18n/ui';
import { rota } from '../i18n/utils';
import { postsEmPercurso, dataPorExtenso, dataISO, tempoRelativo, slugDoPost } from '../lib/blog';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = traduzir(lang);

/**
 * A lista abre pelo texto mais novo e desce até o mais antigo, que é o que se
 * espera de um blog: quem volta ao site vê primeiro o que ainda não leu.
 * O botão "do começo" inverte e mostra o percurso na ordem da curadoria.
 *
 * `postsEmPercurso` devolve do primeiro ao último, então aqui é ao contrário.
 */
const percurso = await postsEmPercurso(lang);
/** Posição de cada texto no percurso, guardada antes de inverter a exibição. */
const posicao = new Map(percurso.map((post, i) => [post.id, i]));
const posts = [...percurso].reverse();
const vazio = posts.length === 0;

/**
 * Assuntos com contagem, do mais usado para o menos.
 *
 * O desempate é o texto mais recente que usa aquele assunto, e não a ordem
 * alfabética. A diferença aparece justamente aqui: quase todo assunto aparece
 * uma vez só, então com contagem empatada o alfabeto decidia tudo, e o começo
 * da lista virava "Angular, Arquitetura, Django, Faria Gallery, Games", com
 * Java, JavaScript, Node.js e Python fora da vista por começarem com letra
 * mais adiante. Agora quem abre a fila é o assunto do que ele escreveu por
 * último, que é o que a pessoa tem mais chance de estar procurando.
 *
 * `posts` já vem do mais novo para o mais antigo, então o menor índice é o
 * mais recente.
 */
const contagem = new Map<string, number>();
const maisRecente = new Map<string, number>();
posts.forEach((post, i) => {
  for (const a of post.data.assuntos) {
    contagem.set(a, (contagem.get(a) ?? 0) + 1);
    if (!maisRecente.has(a)) maisRecente.set(a, i);
  }
});
const assuntos = [...contagem.entries()].sort(
  (a, b) => b[1] - a[1] || maisRecente.get(a[0])! - maisRecente.get(b[0])! || a[0].localeCompare(b[0])
);

/**
 * Quantos assuntos ficam à vista.
 *
 * Aqui é onde o problema aparece primeiro: cada texto novo traz uns três
 * assuntos, quase todos usados uma vez só. Oito textos já davam 22 botões, e
 * cinquenta dariam perto de cem. Os mais usados ficam na frente, o resto entra
 * por um clique. Nada some da página.
 */
const cabemTodos = assuntos.length <= LIMITE_FILTROS + FOLGA_FILTROS;
const aVista = cabemTodos ? assuntos.length : LIMITE_FILTROS;
const recolhidos = assuntos.length - aVista;
---

<Base
  lang={lang}
  titulo={t('blog.titulo')}
  descricao={vazio ? t('meta.blogVazio') : t('meta.blog')}
  semIndexar={vazio}
>
  <Topo lang={lang} />

  <main id="conteudo">
    <section class="abertura wall hang">
      <div class="abertura-corpo">
        <h1 class="titulo-sala">{t('blog.titulo')}</h1>
        <p class="chamada linhas">
          {t('blog.chamada').map((linha, i) => (<>{i > 0 && ' '}<span>{linha}</span></>))}
        </p>
      </div>
    </section>

    <section class="wall">
      {
        vazio ? (
          <div class="vazio hang">
            <p class="field">{t('campo.estado')}</p>
            <div>
              <p class="vazio-titulo">{t('blog.vazio.titulo')}</p>
              <p class="vazio-texto">{t('blog.vazio.texto')}</p>
            </div>
          </div>
        ) : (
          <>
            <div class="filtro hang" data-filtro>
              <p class="field">{t('blog.ordem')}</p>
              <div>
                <div class="etiquetas">
                  <button class="etiqueta etiqueta-ativa" type="button" data-ordem="fim" aria-pressed="true">
                    {t('blog.fim')}
                  </button>
                  <button class="etiqueta" type="button" data-ordem="comeco" aria-pressed="false">
                    {t('blog.comeco')}
                  </button>
                </div>

                {assuntos.length > 0 && (
                  <div class="etiquetas etiquetas-assunto">
                    <button class="etiqueta etiqueta-ativa" type="button" data-tag="" aria-pressed="true">
                      {t('colecao.todas')} <span class="etiqueta-n">{posts.length}</span>
                    </button>
                    {assuntos.map(([a, n], i) => (
                      <button
                        class="etiqueta"
                        type="button"
                        data-tag={a}
                        aria-pressed="false"
                        hidden={i >= aVista}
                        data-recolhida={i >= aVista ? '' : undefined}
                      >
                        {a} <span class="etiqueta-n">{n}</span>
                      </button>
                    ))}
                    {recolhidos > 0 && (
                      <button
                        class="etiqueta etiqueta-mais"
                        type="button"
                        data-mais
                        aria-expanded="false"
                      >
                        {t('filtro.mais')(recolhidos)}
                      </button>
                    )}
                  </div>
                )}

                <p class="contagem" data-contagem>{t('blog.contagem')(posts.length, posts.length)}</p>
              </div>
            </div>

            <ol class="lista" data-lista>
              {posts.map((post) => (
                <li
                  class="hang item"
                  data-tags={post.data.assuntos.join(',')}
                  data-data={dataISO(post.data.data)}
                  data-pos={posicao.get(post.id)}
                >
                  <p class="item-data">
                    <time datetime={dataISO(post.data.data)}>
                      {dataPorExtenso(post.data.data, lang)}
                    </time>{' '}
                    <span class="item-relativo">{tempoRelativo(post.data.data, lang)}</span>
                  </p>
                  <div>
                    <h2 class="work-title">
                      <a class="item-link" href={rota(lang, `/blog/${slugDoPost(post)}`)}>
                        {post.data.titulo}
                      </a>
                    </h2>
                    <p class="item-resumo">{post.data.resumo}</p>
                  </div>
                </li>
              ))}
            </ol>
            <p class="nada" data-nada hidden>{t('blog.nada')}</p>
          </>
        )
      }
    </section>
  </main>

  <Rodape lang={lang} />
</Base>

<script
  is:inline
  define:vars={{
    rotuloMais: recolhidos > 0 ? t('filtro.mais')(recolhidos) : '',
    rotuloMenos: t('filtro.menos'),
  }}
>
  (function () {
    var filtro = document.querySelector('[data-filtro]');
    if (!filtro) return;
    var lista = document.querySelector('[data-lista]');
    var itens = Array.prototype.slice.call(lista.querySelectorAll('.item'));
    var contagem = document.querySelector('[data-contagem]');
    var nada = document.querySelector('[data-nada]');
    var molde = contagem ? contagem.textContent : '';
    var total = itens.length;
    var tagAtual = '';

    // `data-pos` ja vem do servidor na ordem do percurso, entao aqui e' so
    // subir ou descer o numero. Ordenar por data nao serviria: os textos foram
    // escritos quase todos na mesma madrugada.
    function ordenar(ordem) {
      var ordenados = itens.slice().sort(function (a, b) {
        var pa = Number(a.getAttribute('data-pos'));
        var pb = Number(b.getAttribute('data-pos'));
        return ordem === 'fim' ? pb - pa : pa - pb;
      });
      ordenados.forEach(function (li) {
        lista.appendChild(li);
      });
    }

    function filtrar() {
      var visiveis = 0;
      itens.forEach(function (li) {
        var tags = (li.getAttribute('data-tags') || '').split(',');
        var mostra = !tagAtual || tags.indexOf(tagAtual) !== -1;
        li.hidden = !mostra;
        if (mostra) visiveis++;
      });
      if (contagem) {
        contagem.textContent =
          visiveis === total ? molde : molde.replace(String(total), visiveis + ' / ' + total);
      }
      if (nada) nada.hidden = visiveis > 0;
    }

    /* Os assuntos raros ficam recolhidos, e este botão os chama. Recolher
       nunca esconde o assunto que está filtrando a lista: sumir com o filtro
       em uso deixaria a lista curta sem explicação na tela. */
    var recolhiveis = filtro.querySelectorAll('[data-recolhida]');
    var aberto = false;

    filtro.addEventListener('click', function (e) {
      var b = e.target.closest('.etiqueta');
      if (!b) return;

      // Antes de tudo: este botão abre a gaveta, não filtra. Sem esta saída
      // ele cairia no ramo de assunto com a tag vazia e desligaria o filtro.
      if (b.hasAttribute('data-mais')) {
        aberto = !aberto;
        recolhiveis.forEach(function (o) {
          o.hidden = !aberto && !o.classList.contains('etiqueta-ativa');
        });
        b.textContent = aberto ? rotuloMenos : rotuloMais;
        b.setAttribute('aria-expanded', String(aberto));
        return;
      }

      if (b.hasAttribute('data-ordem')) {
        ordenar(b.getAttribute('data-ordem'));
        filtro.querySelectorAll('[data-ordem]').forEach(function (o) {
          var ativo = o === b;
          o.classList.toggle('etiqueta-ativa', ativo);
          o.setAttribute('aria-pressed', String(ativo));
        });
        return;
      }

      // Clicar de novo no assunto ativo desliga o filtro.
      var tag = b.getAttribute('data-tag') || '';
      tagAtual = b.classList.contains('etiqueta-ativa') ? '' : tag;
      filtro.querySelectorAll('[data-tag]').forEach(function (o) {
        var ativo = (o.getAttribute('data-tag') || '') === tagAtual;
        o.classList.toggle('etiqueta-ativa', ativo);
        o.setAttribute('aria-pressed', String(ativo));
      });
      filtrar();
    });
  })();
</script>

<style>
  .abertura {
    padding-block: clamp(3rem, 10vh, 6rem) clamp(2rem, 6vh, 3.5rem);
  }

  .abertura-corpo {
    grid-column: 2 / -1;
  }

  @media (max-width: 47.99rem) {
    .abertura-corpo {
      grid-column: 1 / -1;
    }
  }

  .titulo-sala {
    font-size: clamp(2rem, 1.2rem + 3vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .chamada {
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  /* A quebra vem da classe `linhas`; aqui só a medida do desktop. */
  .chamada span {
    max-width: 50ch;
  }

  .filtro {
    padding-block: 0 1.75rem;
    border-bottom: 1px solid var(--color-rule);
    row-gap: 0.75rem;
  }

  .etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .etiquetas-assunto {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-rule);
  }

  .etiqueta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    background: none;
    border: 1px solid var(--color-rule);
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.75rem;
    color: var(--color-ink-soft);
    transition:
      border-color 180ms ease,
      color 180ms ease,
      background-color 180ms ease;
  }

  .etiqueta:hover {
    border-color: var(--color-ink-soft);
    color: var(--color-ink);
  }

  /* Sem isto o `hidden` não esconde nada: o atributo vale `display: none` na
     folha do navegador, e qualquer `display` escrito aqui ganha dele. */
  .etiqueta[hidden] {
    display: none;
  }

  /* Não é assunto, é a chave que abre a gaveta. Sem moldura, para não ser
     confundida com um filtro a mais. */
  .etiqueta-mais {
    border-color: transparent;
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 0.25em;
  }

  .etiqueta-mais:hover {
    border-color: transparent;
    text-decoration-color: var(--color-ink);
  }

  .etiqueta-ativa {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-wall);
  }

  .etiqueta-n {
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  .contagem {
    margin-top: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .item {
    padding-block: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-rule);
  }

  .item[hidden] {
    display: none;
  }

  .item-data {
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .item-relativo {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.75rem;
    opacity: 0.75;
  }

  @media (min-width: 48rem) {
    .item-data {
      padding-top: 0.6rem;
    }
  }

  .item-link {
    color: inherit;
    text-decoration: none;
  }

  .item-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .item-resumo {
    margin-top: 0.75rem;
    max-width: 46ch;
    font-size: 1rem;
    line-height: 1.6;
  }

  .nada {
    padding-block: 3rem;
    color: var(--color-ink-soft);
    font-size: 1rem;
  }

  .vazio {
    padding-block: clamp(3rem, 8vh, 5rem);
    border-top: 1px solid var(--color-rule);
    row-gap: 0.5rem;
  }

  .vazio-titulo {
    font-family: var(--font-work);
    font-style: italic;
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2rem);
    line-height: 1.1;
  }

  .vazio-texto {
    margin-top: 0.75rem;
    max-width: 42ch;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
</style>
