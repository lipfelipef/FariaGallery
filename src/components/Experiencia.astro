---
import Base from '../layouts/Base.astro';
import Topo from './Topo.astro';
import Rodape from './Rodape.astro';
import Etiqueta from './Etiqueta.astro';
import TempoVivo from './TempoVivo.astro';
import { doTipo } from '../data/obras';
import type { Locale } from '../consts';
import { traduzir } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = traduzir(lang);

/**
 * A sala de experiência não é catálogo, e desde 11/08/2026 tem sala própria.
 *
 * Ela já foi montada pelo `Colecao.astro`, com o mesmo filtro por etiqueta e a
 * mesma ficha recolhida. Com duas entradas aquilo ainda passava. Com uma só,
 * três etiquetas de filtro não filtram nada e a contagem diria "1 obras".
 *
 * O problema maior era outro, e ele apontou: quem entrava lia um nome próprio
 * e a stack ao lado, e a página inteira não dizia em lugar nenhum que aquilo é
 * um canal de YouTube. Era preciso abrir a ficha, ou passar o mouse no link,
 * para descobrir do que se tratava.
 *
 * Aqui a ficha vem aberta, na mesma etiqueta grande do cartaz da home: meio,
 * duração, dimensões, papel, crédito e estado à vista, sem clicar em nada.
 */
const experiencias = doTipo('experiencia');
---

<Base lang={lang} titulo={t('experiencia.titulo')} descricao={t('meta.experiencia')}>
  <Topo lang={lang} />

  <main id="conteudo">
    <section class="abertura wall hang">
      <div class="abertura-corpo">
        <h1 class="titulo-sala">{t('experiencia.titulo')}</h1>
        <p class="chamada linhas">
          {t('experiencia.chamada').map((linha, i) => (<>{i > 0 && ' '}<span>{linha}</span></>))}
        </p>
      </div>
    </section>

    <section class="wall">
      <div class="sala-corpo">
        {
          experiencias.length > 0 ? (
            /* `nivel={2}` porque o título da página é o `h1` logo acima e aqui
               não há sala intermediária, ao contrário da home. */
            experiencias.map((obra) => <Etiqueta obra={obra} lang={lang} nivel={2} />)
          ) : (
            <p class="vazio">{t('experiencia.vazio')}</p>
          )
        }
      </div>
    </section>
  </main>

  <Rodape lang={lang} />
</Base>

{/* O campo DURAÇÃO da ficha é uma conta que continua correndo, e o site é
    estático: sem isto ela ficaria parada no número do último build. */}
<TempoVivo lang={lang} />

<style>
  /* A abertura repete a da coleção, marcação e estilo, e isso é de propósito:
     o CSS de componente no Astro é escopado por atributo, então extrair estas
     quatro regras para um componente comum apagaria o estilo dos dois lados.
     Já quebrou o site uma vez. A repetição é o preço de o estilo valer. */
  .abertura {
    padding-block: clamp(3rem, 10vh, 6rem) clamp(2rem, 6vh, 3.5rem);
  }

  .abertura-corpo {
    grid-column: 2 / -1;
  }

  @media (max-width: 47.99rem) {
    .abertura-corpo {
      grid-column: 1 / -1;
    }
  }

  .titulo-sala {
    font-size: clamp(2rem, 1.2rem + 3vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .chamada {
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  /* A quebra vem da classe `linhas`. A medida acompanha a linha mais longa dos
     três idiomas, senão ela dobraria e desfaria a quebra no computador. */
  .chamada span {
    max-width: 68ch;
  }

  /* O fio que abre a sala, como no cartaz da home: a primeira etiqueta não
     desenha o próprio, e é o container que fecha o topo. Embaixo não precisa
     de fio nenhum: a etiqueta já respira e o rodapé traz o dele. */
  .sala-corpo {
    border-top: 1px solid var(--color-rule);
  }

  .vazio {
    padding-block: 3rem;
    color: var(--color-ink-soft);
    font-size: 1rem;
  }
</style>
