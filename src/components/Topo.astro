---
import { SITE, type Locale } from '../consts';
import { traduzir, UI } from '../i18n/ui';
import { rota } from '../i18n/utils';
import { destinosPorIdioma } from '../lib/idiomas';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = traduzir(lang);

/** Nunca oferece um idioma que levaria a um endereço inexistente. */
const idiomas = await destinosPorIdioma(Astro.url);
---

<header class="topo wall">
  <a class="marca" href={rota(lang, '/')}>{SITE.domain}</a>

  <nav class="direita" aria-label={t('nav.obras')}>
    <ul class="menu">
      <li><a class="quiet-link" href={rota(lang, '/obras')}>{t('nav.colecao')}</a></li>
      <li><a class="quiet-link" href={rota(lang, '/experiencia')}>{t('nav.experiencia')}</a></li>
      <li><a class="quiet-link" href={rota(lang, '/blog')}>{t('nav.blog')}</a></li>
      <li><a class="quiet-link" href={rota(lang, '/contato')}>{t('nav.contato')}</a></li>
    </ul>

    <ul class="idiomas" aria-label={t('idioma.escolher')}>
      {
        idiomas.map(({ lang: outro, href, exata }) => (
          <li>
            <a
              class:list={[
                'idioma',
                outro === lang && 'idioma-atual',
                !exata && 'idioma-parcial',
              ]}
              href={href}
              hreflang={outro}
              lang={outro}
              aria-current={outro === lang ? 'true' : undefined}
              title={
                exata
                  ? UI[outro]['idioma.nome']
                  : `${UI[outro]['idioma.nome']}: ${UI[outro]['idioma.semTexto']}`
              }
            >
              {UI[outro]['idioma.curto']}
            </a>
          </li>
        ))
      }
    </ul>

    <button id="troca-tema" class="tema" type="button" aria-pressed="false">
      <span class="tema-rotulo">{t('tema.escuro')}</span>
    </button>
  </nav>
</header>

<script is:inline define:vars={{ rotuloEscuro: t('tema.escuro'), rotuloClaro: t('tema.clara'), ariaEscuro: t('tema.paraEscuro'), ariaClaro: t('tema.paraClara') }}>
  (function () {
    var botao = document.getElementById('troca-tema');
    if (!botao) return;
    var rotulo = botao.querySelector('.tema-rotulo');
    var raiz = document.documentElement;

    function pintar() {
      var escuro = raiz.getAttribute('data-tema') === 'escuro';
      rotulo.textContent = escuro ? rotuloClaro : rotuloEscuro;
      botao.setAttribute('aria-pressed', String(escuro));
      botao.setAttribute('aria-label', escuro ? ariaClaro : ariaEscuro);
      var meta = document.querySelector('meta[name="theme-color"]:not([media])');
      if (meta) meta.setAttribute('content', escuro ? '#141416' : '#fbfbf9');
    }

    botao.addEventListener('click', function () {
      var escuro = raiz.getAttribute('data-tema') === 'escuro';
      if (escuro) raiz.removeAttribute('data-tema');
      else raiz.setAttribute('data-tema', 'escuro');
      try {
        localStorage.setItem('tema', escuro ? 'claro' : 'escuro');
      } catch (e) {}
      pintar();
    });

    pintar();
  })();
</script>

<style>
  .topo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding-block: 1.75rem;
  }

  .direita {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
  }

  /* Minúsculo, sem caixa alta. O espaçamento largo que funciona em
     versalete atrapalha a leitura de minúscula, então fica bem menor. */
  .marca {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    text-decoration: none;
  }

  @media (max-width: 34rem) {
    .marca {
      flex-basis: 100%;
    }
  }

  .menu,
  .idiomas,
  .tema {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .menu,
  .idiomas {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--color-ink-soft);
  }

  .menu {
    gap: 1.5rem;
  }

  /* Os três idiomas ficam sempre visíveis, separados por barra fina.
     Menu suspenso esconderia a informação de que o site existe em 3. */
  .idiomas {
    gap: 0;
  }

  .idiomas li + li::before {
    content: '/';
    margin-inline: 0.5rem;
    color: var(--color-rule);
  }

  .idioma {
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .idioma:hover {
    color: var(--color-ink);
  }

  .idioma-atual {
    color: var(--color-ink);
  }

  /* Idioma que não tem esta página. Continua clicável e leva ao lugar mais
     próximo, mas fica visivelmente mais apagado para não prometer o que não
     existe. */
  .idioma-parcial {
    opacity: 0.45;
  }

  .idioma-parcial:hover {
    opacity: 1;
  }

  /* Mesma tipografia do menu: é rótulo de sala, não enfeite. */
  .tema {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    color: var(--color-ink-soft);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    transition: color 200ms ease, text-decoration-color 200ms ease;
  }

  .tema:hover {
    color: var(--color-ink);
    text-decoration-color: var(--color-rule);
  }
</style>
