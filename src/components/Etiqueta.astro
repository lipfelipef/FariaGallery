---
import type { Locale } from '../consts';
import { anoExibido, inicioDaObra, fimDaObra, linhasDe, meioDe, type Obra } from '../data/obras';
import { traduzir } from '../i18n/ui';
import { rota } from '../i18n/utils';
import { duracao } from '../lib/tempo';

interface Props {
  obra: Obra;
  lang: Locale;
  /** Id do post do blog escrito sobre esta obra, quando existir. */
  post?: string;
}

const { obra, lang, post } = Astro.props;
const t = traduzir(lang);
const urlTexto = post ? rota(lang, `/blog/${post}`) : undefined;

const naoPreenchido = (valor: string) =>
  obra.pendente && /^(a definir|to be defined)$/i.test(valor);

/** Calculada da data, não escrita à mão: assim ela não envelhece sozinha. */
const inicio = inicioDaObra(obra);
const quanto = inicio ? duracao(inicio, fimDaObra(obra), lang) : undefined;

/** Cada valor da ficha é uma lista de linhas, mesmo quando tem só uma. */
const ficha = [
  { campo: t('campo.meio'), linhas: [meioDe(obra, lang)] },
  ...(quanto ? [{ campo: t('campo.duracao'), linhas: [quanto] }] : []),
  ...(obra.dimensoes ? [{ campo: t('campo.dimensoes'), linhas: [obra.dimensoes[lang]] }] : []),
  { campo: t('campo.papel'), linhas: [obra.papel[lang]] },
  { campo: t('campo.credito'), linhas: linhasDe(obra.credito[lang]) },
  { campo: t('campo.estado'), linhas: [t(`estado.${obra.estado}` as 'estado.publico')] },
];

const textoDoLink = obra.link
  ? t(`link.${obra.link.tipo}` as 'link.codigo')
  : '';
---

<article class="obra hang">
  <div class="obra-margem">
    <span class="dot dot-on" aria-hidden="true"></span>
    <span class="obra-ano">{anoExibido(obra, t('tempo.atualmente'))}</span>
  </div>

  <div class="obra-cabeca">
    <h3 class="work-title">
      {
        urlTexto ? (
          <a class="titulo-link" href={urlTexto}>
            {obra.titulo}
          </a>
        ) : (
          obra.titulo
        )
      }
    </h3>
    <p class="obra-resumo">
      {linhasDe(obra.resumo[lang]).map((linha) => <span>{linha}</span>)}
    </p>
  </div>

  <dl class="obra-ficha">
    {
      ficha.map(({ campo, linhas }) => (
        <>
          <dt class="field">{campo}</dt>
          <dd
            class:list={[
              'value',
              naoPreenchido(linhas[0]) && 'value-pendente',
              /* Quem escreveu a quebra quer aquelas linhas, então a medida de
                 leitura de 46ch dá lugar a uma que as comporte. Sem isto a
                 frase dobra e a quebra escolhida some no meio. */
              linhas.length > 1 && 'value-linhas',
            ]}
          >
            {linhas.map((linha) => (
              <span>{linha}</span>
            ))}
          </dd>
        </>
      ))
    }
  </dl>

  {
    (urlTexto || obra.link) && (
      <p class="obra-acao">
        {urlTexto && (
          <a class="quiet-link" href={urlTexto}>
            {t('link.texto')} <span aria-hidden="true">&#8594;</span>
          </a>
        )}
        {obra.link && (
          <a class="quiet-link" href={obra.link.href} target="_blank" rel="noopener noreferrer">
            {textoDoLink} <span aria-hidden="true">&#8594;</span>
            <span class="sr-only">{t('link.novaAba')}</span>
          </a>
        )}
      </p>
    )
  }
</article>

<style>
  .obra {
    row-gap: 0.5rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-rule);
  }

  .obra:first-child {
    border-top: 0;
  }

  /* Margem: o ponto e o ano. O ano em coluna cria a espinha
     cronológica que dá pra ler de relance descendo a página. */
  .obra-margem {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .obra-margem .dot {
    transform: translateY(-0.15em);
  }

  @media (min-width: 48rem) {
    .obra-margem {
      padding-top: 0.85rem;
    }
  }

  .obra-cabeca {
    margin-bottom: 1.5rem;
  }

  .obra-resumo {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-ink);
  }

  /* Uma frase por linha quando a ficha traz o texto quebrado. */
  .obra-resumo span,
  .value span {
    display: block;
  }

  .obra-resumo span {
    max-width: 62ch;
  }

  /* O `.value` global limita a 46ch, medida de leitura para texto corrido.
     Onde o texto foi quebrado à mão, a medida acompanha a linha mais longa,
     senão a coluna dobra a frase e desfaz a quebra. */
  .value-linhas {
    max-width: 80ch;
  }

  /* A ficha repete a mesma grade da obra, então o eixo vertical
     da página inteira continua sendo um só. */
  .obra-ficha {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: var(--hang) minmax(0, 1fr);
    column-gap: var(--gutter);
    row-gap: 0.5rem;
  }

  @media (max-width: 47.99rem) {
    .obra-ficha {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.125rem;
    }
  }

  .value-pendente {
    color: var(--color-ink-soft);
    font-style: italic;
  }

  .titulo-link {
    color: inherit;
    text-decoration: none;
  }

  .titulo-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .obra-acao {
    grid-column: 1 / -1;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  @media (min-width: 48rem) {
    .obra-acao {
      grid-column: 2 / -1;
    }
  }

  /* `.sr-only` mora no global.css: dois componentes usam. */
</style>
