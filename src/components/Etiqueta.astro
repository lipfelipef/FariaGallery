---
import type { Locale } from '../consts';
import {
  anoExibido,
  inicioDaObra,
  fimDaObra,
  linhasDe,
  meioDe,
  numeroColado,
  type Obra,
} from '../data/obras';
import { traduzir } from '../i18n/ui';
import { rota } from '../i18n/utils';
import { duracao } from '../lib/tempo';

interface Props {
  obra: Obra;
  lang: Locale;
  /** Id do post do blog escrito sobre esta obra, quando existir. */
  post?: string;
}

const { obra, lang, post } = Astro.props;
const t = traduzir(lang);
const urlTexto = post ? rota(lang, `/blog/${post}`) : undefined;

const naoPreenchido = (valor: string) =>
  obra.pendente && /^(a definir|to be defined)$/i.test(valor);

/** Calculada da data, não escrita à mão: assim ela não envelhece sozinha. */
const inicio = inicioDaObra(obra);
const quanto = inicio ? duracao(inicio, fimDaObra(obra), lang) : undefined;

/**
 * Cada valor da ficha é uma lista de linhas, mesmo quando tem só uma.
 *
 * `medida` é a medida tipográfica: a largura que a linha pode ocupar. Marca o
 * campo que enumera em vez de narrar, como as dimensões e o papel. Ali a
 * medida de leitura confortável do `.value` atrapalha, porque dobra a
 * enumeração no meio e pendura a última palavra sozinha na linha de baixo.
 */
const ficha = [
  { campo: t('campo.meio'), linhas: [meioDe(obra, lang)] },
  ...(quanto ? [{ campo: t('campo.duracao'), linhas: [quanto] }] : []),
  ...(obra.dimensoes
    ? [
        {
          campo: t('campo.dimensoes'),
          linhas: linhasDe(obra.dimensoes[lang]).map(numeroColado),
          medida: true,
        },
      ]
    : []),
  { campo: t('campo.papel'), linhas: [obra.papel[lang]], medida: true },
  { campo: t('campo.credito'), linhas: linhasDe(obra.credito[lang]) },
  { campo: t('campo.estado'), linhas: [t(`estado.${obra.estado}` as 'estado.publico')] },
];

const textoDoLink = obra.link
  ? t(`link.${obra.link.tipo}` as 'link.codigo')
  : '';
---

<!-- O id é o alvo dos marcos da linha do percurso, na home. -->
<article class="obra hang" id={obra.slug}>
  <div class="obra-margem">
    <span class="dot dot-on" aria-hidden="true"></span>
    <span class="obra-ano">{anoExibido(obra, t('tempo.atualmente'))}</span>
  </div>

  <div class="obra-cabeca">
    <h3 class="work-title">
      {
        urlTexto ? (
          <a class="titulo-link" href={urlTexto}>
            {obra.titulo}
          </a>
        ) : (
          obra.titulo
        )
      }
    </h3>
    <p class="obra-resumo linhas">
      {linhasDe(obra.resumo[lang]).map((linha, i) => (<>{i > 0 && ' '}<span>{linha}</span></>))}
    </p>
  </div>

  <dl class="obra-ficha">
    {
      ficha.map(({ campo, linhas, medida }) => (
        <>
          <dt class="field">{campo}</dt>
          {/* Quem escreveu a quebra quer aquelas linhas, então a medida de
              leitura de 46ch dá lugar a uma que as comporte, senão a frase
              dobra e a quebra escolhida some no meio. */}
          <dd
            class:list={[
              'value',
              'linhas',
              naoPreenchido(linhas[0]) && 'value-pendente',
              linhas.length > 1 && 'value-linhas',
              medida && 'value-medida',
            ]}
          >
            {linhas.map((linha, i) => (
              <>
                {i > 0 && ' '}
                <span>{linha}</span>
              </>
            ))}
          </dd>
        </>
      ))
    }
  </dl>

  {
    (urlTexto || obra.link) && (
      <p class="obra-acao">
        {urlTexto && (
          <a class="quiet-link" href={urlTexto}>
            {t('link.texto')} <span aria-hidden="true">&#8594;</span>
          </a>
        )}{' '}
        {obra.link && (
          <a class="quiet-link" href={obra.link.href} target="_blank" rel="noopener noreferrer">
            {/* O espaço precisa ser explícito: quebra de linha entre duas
                tags some na compilação, e o texto extraído sairia com a seta
                grudada no aviso, "→(abre em nova aba)". */}
            {textoDoLink} <span aria-hidden="true">&#8594;</span>{' '}
            <span class="sr-only">{t('link.novaAba')}</span>
          </a>
        )}
      </p>
    )
  }
</article>

<style>
  .obra {
    row-gap: 0.5rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-rule);
    /* Vindo de um marco do percurso, a etiqueta para um pouco abaixo do topo
       da janela, em vez de encostar nela. */
    scroll-margin-top: clamp(1.5rem, 4vh, 3rem);
  }

  .obra:first-child {
    border-top: 0;
  }

  /* Margem: o ponto e o ano. O ano em coluna cria a espinha
     cronológica que dá pra ler de relance descendo a página. */
  .obra-margem {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .obra-margem .dot {
    transform: translateY(-0.15em);
  }

  @media (min-width: 48rem) {
    .obra-margem {
      padding-top: 0.85rem;
    }
  }

  .obra-cabeca {
    margin-bottom: 1.5rem;
  }

  .obra-resumo {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-ink);
  }

  /* A quebra vem da classe `linhas`, no global.css. */
  .obra-resumo span {
    max-width: 62ch;
  }

  /* O `.value` global limita a 46ch, medida de leitura para texto corrido.
     Onde o texto foi quebrado à mão, a medida acompanha a linha mais longa,
     senão a coluna dobra a frase e desfaz a quebra. */
  .value-linhas {
    max-width: 80ch;
  }

  /* Campo que enumera, e não narra: dimensões e papel. Ali a linha quer caber
     inteira, e os 46ch do `.value` dão 395px, que dobram todas elas. As que
     precisam de mais espaço, medidas na tipografia real:

       papel da BluckerTV        453px  (a maior de todas)
       dimensões da galeria      425px  em espanhol
       dimensões da BluckerTV    396px  na primeira linha

     60ch dão 516px, com folga de 63 sobre a maior. A coluna tem 824px, então
     espaço nunca faltou: faltava permissão.

     Vem depois do `.value-linhas` de propósito. As duas têm a mesma força, e
     quando um campo enumera em várias linhas, como as dimensões da BluckerTV,
     quem deve mandar é esta.

     Só no computador. No celular a coluna tem a largura da tela e a linha
     dobra de qualquer jeito, que é como ele quer. */
  @media (min-width: 48rem) {
    .value-medida {
      max-width: 60ch;
    }
  }

  /* A ficha repete a mesma grade da obra, então o eixo vertical
     da página inteira continua sendo um só. */
  .obra-ficha {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: var(--hang) minmax(0, 1fr);
    column-gap: var(--gutter);
    row-gap: 0.5rem;
  }

  @media (max-width: 47.99rem) {
    .obra-ficha {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.125rem;
    }
  }

  .value-pendente {
    color: var(--color-ink-soft);
    font-style: italic;
  }

  .titulo-link {
    color: inherit;
    text-decoration: none;
  }

  .titulo-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .obra-acao {
    grid-column: 1 / -1;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  @media (min-width: 48rem) {
    .obra-acao {
      grid-column: 2 / -1;
    }
  }

  /* `.sr-only` mora no global.css: dois componentes usam. */
</style>
