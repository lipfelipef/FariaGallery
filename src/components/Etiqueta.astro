---
import type { Locale } from '../consts';
/* `linhasDe` continua sendo usado pelo resumo, logo abaixo do título: ele não
   faz parte da ficha e não saiu junto com ela para o `lib/ficha.ts`. */
import { anoExibido, linhasDe, type Obra } from '../data/obras';
import { traduzir } from '../i18n/ui';
import { fichaDaObra } from '../lib/ficha';

interface Props {
  obra: Obra;
  lang: Locale;
  /**
   * O nível do título da obra.
   *
   * Na home a etiqueta mora dentro de uma sala que já tem `h2` ("Em cartaz"),
   * então o título dela é `h3`. Na experiência ela vem logo abaixo do `h1` da
   * página, sem sala intermediária, e um `h3` ali pularia o `h2`: quem navega
   * por cabeçalho no leitor de tela lê a página como se tivesse perdido um
   * nível pelo caminho.
   */
  nivel?: 2 | 3;
  /**
   * Mostra o ano como período aberto, "2021 - atualmente", em vez do ano seco.
   *
   * No cartaz da home o ano é seco por decisão dele em 10/08/2026: lá as três
   * etiquetas formam uma coluna de anos alinhados na margem, e quem diz se a
   * obra ainda corre é o campo ESTADO da ficha. Na experiência não existe
   * coluna para alinhar, a etiqueta está sozinha na página, e o período é o
   * que ele quer ler ali: sentiu falta assim que o catálogo saiu, porque o
   * rótulo do grupo mostrava isso antes.
   *
   * Só tem efeito em obra com `ativa`, que é onde `anoExibido` acrescenta o
   * sufixo. Sem ela, o ano sai seco de qualquer jeito.
   */
  periodo?: boolean;
}

const { obra, lang, nivel = 3, periodo = false } = Astro.props;
const t = traduzir(lang);

/* Tag dinâmica, não classe: o estilo do título é o `.work-title` do
   global.css, e ele não olha para a tag. */
const Titulo = nivel === 2 ? 'h2' : 'h3';

const naoPreenchido = (valor: string) =>
  obra.pendente && /^(a definir|to be defined)$/i.test(valor);

/** A lista de campos mora em `lib/ficha.ts`: a coleção mostra a mesma. */
const ficha = fichaDaObra(obra, lang);

const textoDoLink = obra.link
  ? t(`link.${obra.link.tipo}` as 'link.codigo')
  : '';
---

<!-- O id é o alvo dos marcos da linha do percurso, na home. -->
<article class="obra hang" id={obra.slug}>
  <div class="obra-margem">
    <span class="dot dot-on" aria-hidden="true"></span>
    {/* Ano seco no cartaz, período aberto na experiência: quem escolhe é o
        `periodo`, e o porquê de cada sala está na definição dele. */}
    <span class="obra-ano">{periodo ? anoExibido(obra, t('tempo.atualmente')) : obra.ano}</span>
  </div>

  <div class="obra-cabeca">
    {/* Título sem link: o destino da obra é um só, e ele está na linha de ação
        no fim da etiqueta, com o nome do lugar para onde leva. Dois links para
        o mesmo endereço na mesma etiqueta era ruído. */}
    <Titulo class="work-title">{obra.titulo}</Titulo>
    <p class="obra-resumo linhas">
      {linhasDe(obra.resumo[lang]).map((linha, i) => (<>{i > 0 && ' '}<span>{linha}</span></>))}
    </p>
  </div>

  <dl class="obra-ficha">
    {
      ficha.map(({ campo, linhas, medida, vivo }) => (
        <>
          <dt class="field">{campo}</dt>
          {/* Quem escreveu a quebra quer aquelas linhas, então a medida de
              leitura de 46ch dá lugar a uma que as comporte, senão a frase
              dobra e a quebra escolhida some no meio.

              `data-vivo` marca a conta de tempo que ainda corre, para o
              `TempoVivo` refazer o número no relógio de São Paulo. */}
          <dd
            data-vivo={vivo}
            class:list={[
              'value',
              'linhas',
              naoPreenchido(linhas[0]) && 'value-pendente',
              linhas.length > 1 && 'value-linhas',
              medida && 'value-medida',
            ]}
          >
            {linhas.map((linha, i) => (
              <>
                {i > 0 && ' '}
                <span>{linha}</span>
              </>
            ))}
          </dd>
        </>
      ))
    }
  </dl>

  {
    obra.link && (
      <p class="obra-acao">
        <a class="quiet-link" href={obra.link.href} target="_blank" rel="noopener noreferrer">
          {/* O espaço precisa ser explícito: quebra de linha entre duas
              tags some na compilação, e o texto extraído sairia com a seta
              grudada no aviso, "→(abre em nova aba)". */}
          {textoDoLink} <span aria-hidden="true">&#8594;</span>{' '}
          <span class="sr-only">{t('link.novaAba')}</span>
        </a>
      </p>
    )
  }
</article>

<style>
  .obra {
    row-gap: 0.5rem;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--color-rule);
    /* Vindo de um marco do percurso, a etiqueta para um pouco abaixo do topo
       da janela, em vez de encostar nela. */
    scroll-margin-top: clamp(1.5rem, 4vh, 3rem);
  }

  .obra:first-child {
    border-top: 0;
  }

  /* Margem: o ponto e o ano. O ano em coluna cria a espinha
     cronológica que dá pra ler de relance descendo a página. */
  .obra-margem {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .obra-margem .dot {
    transform: translateY(-0.15em);
  }

  @media (min-width: 48rem) {
    .obra-margem {
      padding-top: 0.85rem;
    }
  }

  .obra-cabeca {
    margin-bottom: 1.5rem;
  }

  .obra-resumo {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--color-ink);
  }

  /* A quebra vem da classe `linhas`, no global.css. */
  .obra-resumo span {
    max-width: 62ch;
  }

  /* `.value-linhas` e `.value-medida` moram no `global.css`: a ficha aparece
     em dois lugares agora, aqui e no catálogo da coleção, e classe usada por
     dois componentes não pode ficar escopada em um deles. */

  /* A ficha repete a mesma grade da obra, então o eixo vertical
     da página inteira continua sendo um só. */
  .obra-ficha {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: var(--hang) minmax(0, 1fr);
    column-gap: var(--gutter);
    row-gap: 0.5rem;
  }

  @media (max-width: 47.99rem) {
    .obra-ficha {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.125rem;
    }
  }

  .value-pendente {
    color: var(--color-ink-soft);
    font-style: italic;
  }

  .obra-acao {
    grid-column: 1 / -1;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  @media (min-width: 48rem) {
    .obra-acao {
      grid-column: 2 / -1;
    }
  }

  /* `.sr-only` mora no global.css: dois componentes usam. */
</style>
