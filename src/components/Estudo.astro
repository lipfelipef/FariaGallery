---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Topo from './Topo.astro';
import Rodape from './Rodape.astro';
import type { Locale } from '../consts';
import type { Obra } from '../data/obras';
import { traduzir } from '../i18n/ui';
import { rota } from '../i18n/utils';
import type { Estudo } from '../lib/estudos';

interface Props {
  estudo: Estudo;
  obra: Obra;
  lang: Locale;
}

const { estudo, obra, lang } = Astro.props;
const t = traduzir(lang);
const { Content } = await render(estudo);

const aoVivo = obra.estado !== 'encerrado';

/**
 * A ficha aqui é a mesma da parede, mais as "dimensões" que não cabem na
 * etiqueta curta: duração e tamanho do time. Num museu, medida é campo
 * obrigatório; em software, é o que mais diz sobre como foi trabalhar nisso.
 */
const ficha = [
  { campo: t('campo.meio'), valor: obra.meio },
  { campo: t('campo.papel'), valor: obra.papel[lang] },
  ...(estudo.data.duracao ? [{ campo: t('campo.duracao'), valor: estudo.data.duracao }] : []),
  ...(estudo.data.equipe ? [{ campo: t('campo.equipe'), valor: estudo.data.equipe }] : []),
  { campo: t('campo.credito'), valor: obra.credito[lang] },
  { campo: t('campo.estado'), valor: t(`estado.${obra.estado}` as 'estado.publico') },
];
---

<Base lang={lang} titulo={obra.titulo} descricao={estudo.data.chamada}>
  <Topo lang={lang} />

  <main id="conteudo">
    <article class="wall">
      <header class="cabeca hang">
        <div class="cabeca-margem">
          <span class:list={['dot', aoVivo ? 'dot-on' : 'dot-off']} aria-hidden="true"></span>
          <span>{obra.ano}</span>
        </div>

        <div class="cabeca-corpo">
          <h1 class="work-title titulo">{obra.titulo}</h1>
          <p class="chamada">{estudo.data.chamada}</p>
        </div>

        <dl class="ficha">
          {
            ficha.map(({ campo, valor }) => (
              <>
                <dt class="field">{campo}</dt>
                <dd class="value">{valor}</dd>
              </>
            ))
          }
        </dl>

        {
          obra.link && (
            <p class="acao">
              <a class="quiet-link" href={obra.link.href} target="_blank" rel="noopener noreferrer">
                {t(`link.${obra.link.tipo}` as 'link.codigo')} <span aria-hidden="true">&#8594;</span>
                <span class="sr-only">{t('link.novaAba')}</span>
              </a>
            </p>
          )
        }
      </header>

      <div class="hang">
        <div class="prosa">
          <Content />
        </div>
      </div>

      <p class="volta hang">
        <span></span>
        <a class="quiet-link" href={`${rota(lang, '/')}#obras`}>{t('obras.voltar')}</a>
      </p>
    </article>
  </main>

  <Rodape lang={lang} />
</Base>

<style>
  .cabeca {
    padding-block: clamp(3rem, 10vh, 5.5rem) clamp(2rem, 5vh, 3rem);
    row-gap: 0.5rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .cabeca-margem {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 48rem) {
    .cabeca-margem {
      padding-top: 1.6rem;
    }
  }

  .cabeca-corpo {
    margin-bottom: 1.5rem;
  }

  .titulo {
    font-size: clamp(2.125rem, 1.3rem + 3.4vw, 3.25rem);
  }

  .chamada {
    margin-top: 1rem;
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .ficha {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: var(--hang) minmax(0, 1fr);
    column-gap: var(--gutter);
    row-gap: 0.5rem;
  }

  @media (max-width: 47.99rem) {
    .ficha {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.125rem;
    }
  }

  .acao {
    grid-column: 1 / -1;
    margin-top: 1.5rem;
    font-size: 0.875rem;
  }

  @media (min-width: 48rem) {
    .acao {
      grid-column: 2 / -1;
    }
  }

  .prosa {
    grid-column: 2 / -1;
    padding-block: clamp(2.5rem, 6vh, 4rem);
  }

  @media (max-width: 47.99rem) {
    .prosa {
      grid-column: 1 / -1;
    }
  }

  .volta {
    padding-bottom: clamp(2rem, 6vh, 4rem);
    font-size: 0.875rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
