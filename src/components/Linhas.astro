---
/**
 * Texto quebrado à mão: uma frase por linha onde há largura, texto corrido no
 * celular.
 *
 * O espaço que separa as frases é escrito aqui, no fim de cada uma, e não por
 * CSS. Tentei com `::before { content: ' ' }` e o espaço é colapsado; com
 * `\00a0` ele para de colapsar mas também impede a quebra justamente no melhor
 * ponto, o fim da frase. Escrito no HTML, ele some quando cada frase é um
 * bloco e separa quando elas viram texto corrido.
 *
 * O comportamento de quebra mora na classe `linhas`, em global.css.
 */
interface Props {
  linhas: readonly string[];
  /** Elemento externo. `p` na maioria dos casos, `span` dentro de parágrafo. */
  como?: 'p' | 'span' | 'dd';
  class?: string;
}

const { linhas, como = 'p', class: classe } = Astro.props;
const Tag = como;
const ultima = linhas.length - 1;
---

<Tag class:list={['linhas', classe]}>
  {linhas.map((linha, i) => <span>{i < ultima ? `${linha} ` : linha}</span>)}
</Tag>
