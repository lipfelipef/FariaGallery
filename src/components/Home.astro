---
import Base from '../layouts/Base.astro';
import Topo from './Topo.astro';
import Rodape from './Rodape.astro';
import Etiqueta from './Etiqueta.astro';
import { OBRAS, doTipo } from '../data/obras';
import { SITE, SOCIAL, type Locale } from '../consts';
import { traduzir } from '../i18n/ui';
import { rota } from '../i18n/utils';
import { postsPorObra, postsPublicados } from '../lib/blog';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = traduzir(lang);

/** Obra só vira link quando existe post escrito sobre ela naquele idioma. */
const textoDaObra = await postsPorObra(lang);

/**
 * Ficha sem conteúdo preenchido não entra em contagem nem vai pra parede.
 * Some do site inteiro enquanto estiver marcada como `pendente`.
 */
const obras = doTipo('obra');
const experiencias = doTipo('experiencia');
const totalTextos = (await postsPublicados(lang)).length;

/**
 * A home é a exposição, não o acervo. Só o que está marcado como destaque
 * fica pendurado aqui, com a ficha inteira, e a curadoria ignora o tipo de
 * propósito: se a coisa mais forte é uma experiência, ela vem para a parede.
 * A ordem é a do campo `destaque`, escolhida a dedo, não a cronologia.
 */
const emCartaz = OBRAS.filter((o) => !o.pendente && o.destaque).sort(
  (a, b) => (a.destaque ?? 99) - (b.destaque ?? 99)
);

---

<Base lang={lang} descricao={t('meta.home')}>
  <Topo lang={lang} />

  <main id="conteudo">
    <!-- Parede de entrada: no museu é o texto que abre a exposição. -->
    <section class="entrada wall hang">
      <div class="entrada-corpo entrance">
        <h1 class="nome">{SITE.name}</h1>
        <p class="linha-artista">{t('artista')}</p>

        <div class="texto-parede">
          <p>{t('parede.1')}</p>
          <p>{t('parede.2')}</p>
        </div>

        <p class="acervo">
          {t('acervo')(obras.length, experiencias.length, totalTextos)}
        </p>

        <!-- Aviso de disponibilidade. Fica na entrada porque é a primeira coisa
             que um recrutador procura, e leva direto ao contato. -->
        <p class="disponivel">
          <span class="dot dot-on" aria-hidden="true"></span>
          <a class="quiet-link" href={rota(lang, '/contato')}>{t('disponivel')}</a>
        </p>
      </div>
    </section>

    <section id="obras" class="sala wall">
      <h2 class="sala-titulo">{t('sala.emCartaz')}</h2>
      <!-- A ordem conta a sequência: o canal levou à plataforma de vídeo, que
           levou ao e-commerce. Ver o campo `destaque` em obras.ts. -->
      <div class="sala-corpo">
        {
          emCartaz.map((obra) => (
            <Etiqueta obra={obra} lang={lang} post={textoDaObra.get(obra.slug)} />
          ))
        }

        <p class="para-colecao hang">
          <span></span>
          <a class="quiet-link" href={rota(lang, '/obras')}>
            {t('colecao.verTudo')(obras.length)} <span aria-hidden="true">&#8594;</span>
          </a>
        </p>
      </div>
    </section>

    <section id="redes" class="sala wall">
      <h2 class="sala-titulo">{t('sala.redes')}</h2>
      <div class="sala-corpo">
        <!-- Cada rede é uma linha inteira, no mesmo desenho das linhas da
             coleção: o alvo de clique ocupa a largura toda, em vez de ser um
             nome curto perdido no meio de uma faixa vazia. -->
        <ul class="redes">
          {
            SOCIAL.map(({ rede, usuario, href }) => (
              <li>
                <a class="rede" href={href} rel="me noopener noreferrer" target="_blank">
                  <span class="field rede-nome">{rede}</span>
                  <span class="rede-usuario">{usuario}</span>
                  <span class="rede-seta" aria-hidden="true">
                    &#8599;
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <Rodape lang={lang} />
</Base>

<style>
  .entrada {
    padding-block: clamp(4rem, 14vh, 9rem) clamp(4rem, 10vh, 7rem);
  }

  .entrada-corpo {
    grid-column: 2 / -1;
  }

  @media (max-width: 47.99rem) {
    .entrada-corpo {
      grid-column: 1 / -1;
    }
  }

  .nome {
    font-size: clamp(2.75rem, 1.4rem + 5.4vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .linha-artista {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
    max-width: 34ch;
  }

  .texto-parede {
    margin-top: 2.5rem;
    display: grid;
    gap: 1rem;
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .acervo {
    margin-top: 2.5rem;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .sala {
    padding-block: clamp(2rem, 5vh, 3.5rem) clamp(3rem, 8vh, 5rem);
  }

  /* O nome da sala é uma plaquinha, não um letreiro. Mesma tipografia
     dos campos da etiqueta, porque cumpre a mesma função. */
  .sala-titulo {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    padding-bottom: 1.25rem;
  }

  .sala-corpo {
    border-top: 1px solid var(--color-rule);
  }

  /* Disponibilidade. Mesma voz de campo da etiqueta, com o ponto vermelho na
     frente para o olho achar antes de ler. */
  .disponivel {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .disponivel .dot {
    flex: none;
  }

  /* Já teve um fio ligando os pontos das etiquetas aqui, e foi removido:
     como cada etiqueta é alta, o fio virava um traço comprido descendo o bloco
     inteiro em vez de ligar um ponto ao outro. A sequência continua sendo dada
     pela ordem em que as três aparecem. */

  .canais {
    padding-block: clamp(2rem, 4vw, 3rem) 0;
    row-gap: 0.75rem;
  }

  @media (max-width: 47.99rem) {
    .canais {
      row-gap: 0.125rem;
    }
  }

  .para-colecao {
    padding-block: clamp(2rem, 4vw, 2.75rem);
    border-top: 1px solid var(--color-rule);
    font-size: 0.875rem;
  }

  .redes {
    list-style: none;
    margin: 0;
    padding: 0;
    padding-block: clamp(1.5rem, 3vw, 2rem) clamp(2rem, 4vw, 3rem);
  }

  /* Mesma anatomia da linha da coleção: rótulo na coluna da margem, valor no
     corpo, seta na ponta aparecendo no hover. */
  .rede {
    display: grid;
    grid-template-columns: var(--hang) minmax(0, 1fr) 1.25rem;
    align-items: baseline;
    gap: 0 var(--gutter);
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-rule);
    color: inherit;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .redes li:first-child .rede {
    border-top: 1px solid var(--color-rule);
  }

  .rede:hover {
    background-color: var(--color-paper);
  }

  .rede-nome {
    padding-top: 0;
  }

  .rede-usuario {
    font-size: 1.0625rem;
    color: var(--color-ink);
  }

  .rede-seta {
    justify-self: end;
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    opacity: 0;
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .rede:hover .rede-seta {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  @media (max-width: 47.99rem) {
    .rede {
      grid-template-columns: minmax(0, 1fr) 1.25rem;
      row-gap: 0.2rem;
    }

    .rede-nome {
      grid-column: 1 / -1;
      margin-top: 0;
    }
  }

  .curriculo {
    padding-block: 1.75rem clamp(2rem, 4vw, 3rem);
  }

  /* Botão de verdade, não link de texto: currículo é a ação que o
     recrutador procura, e precisa de alvo grande e contorno visível.
     Inverte no hover em vez de acender uma cor que não existe no site. */
  .botao {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    border: 1px solid var(--color-ink);
    padding: 0.85rem 1.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .botao:hover {
    background-color: var(--color-ink);
    color: var(--color-wall);
  }

  .botao-seta {
    font-size: 0.875rem;
    transition: transform 180ms ease;
  }

  .botao:hover .botao-seta {
    transform: translateY(2px);
  }
</style>
