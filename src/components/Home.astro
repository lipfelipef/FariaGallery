---
import Base from '../layouts/Base.astro';
import Topo from './Topo.astro';
import Rodape from './Rodape.astro';
import Etiqueta from './Etiqueta.astro';
import { OBRAS, doTipo } from '../data/obras';
import { SITE, SOCIAL, type Locale } from '../consts';
import { traduzir } from '../i18n/ui';
import { rota } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = traduzir(lang);

/**
 * Ficha sem conteúdo preenchido não entra em contagem nem vai pra parede.
 * Some do site inteiro enquanto estiver marcada como `pendente`.
 */
const obras = doTipo('obra');
const experiencias = doTipo('experiencia');

/**
 * A home é a exposição, não o acervo. Só o que está marcado como destaque
 * fica pendurado aqui, com a ficha inteira, e a curadoria ignora o tipo de
 * propósito: se a coisa mais forte é uma experiência, ela vem para a parede.
 * A ordem é a do campo `destaque`, escolhida a dedo, não a cronologia.
 */
const emCartaz = OBRAS.filter((o) => !o.pendente && o.destaque).sort(
  (a, b) => (a.destaque ?? 99) - (b.destaque ?? 99)
);

/**
 * O percurso: as mesmas obras do cartaz, na ordem em que uma levou à outra.
 *
 * Fica numa faixa própria, horizontal, acima das etiquetas. Já tentei ligar as
 * etiquetas com um fio vertical e não funciona: cada uma tem quinhentos a
 * oitocentos pixels de altura, então o fio nunca alcança o ponto seguinte, ele
 * só desce sozinho pelo bloco. Aqui os marcos ficam lado a lado, que é a
 * condição para uma linha de tempo ser lida como linha.
 *
 * A ordem é o `destaque` de trás para frente, e não uma conta de data: o
 * Blucker e a BluckerTV são os dois de 2026, e só a curadoria dele sabe qual
 * levou a qual.
 */
const percurso = [...emCartaz].reverse();

---

<Base lang={lang} descricao={t('meta.home')}>
  <Topo lang={lang} />

  <main id="conteudo">
    <!-- Parede de entrada: no museu é o texto que abre a exposição. -->
    <section class="entrada wall hang">
      <div class="entrada-corpo entrance">
        <h1 class="nome">{SITE.name}</h1>
        <p class="linha-artista linhas">
          {t('artista').map((linha, i) => (<>{i > 0 && ' '}<span>{linha}</span></>))}
        </p>

        <div class="texto-parede">
          <p>{t('parede.1')}</p>
          <p>{t('parede.2')}</p>
        </div>

        <p class="acervo linhas">
          {t('acervo')(obras.length, experiencias.length).map((linha, i) => (
            <>
              {i > 0 && ' '}
              <span>{linha}</span>
            </>
          ))}
        </p>

        <!-- Aviso de disponibilidade. Fica na entrada porque é a primeira coisa
             que um recrutador procura, e leva direto ao contato. -->
        <p class="disponivel">
          <span class="dot dot-on" aria-hidden="true"></span>
          <a class="quiet-link" href={rota(lang, '/contato')}>{t('disponivel')}</a>
        </p>
      </div>
    </section>

    <section id="obras" class="sala wall">
      <h2 class="sala-titulo">{t('sala.emCartaz')}</h2>

      <!-- A linha do percurso: uma coisa levou à outra, e isso se lê de uma vez
           só, da esquerda para a direita. Fica fora das etiquetas de propósito. -->
      <ol class="percurso" aria-label={t('sala.percurso')}>
        {
          percurso.map((obra) => (
            <li class="marco">
              <a class="marco-link" href={`#${obra.slug}`}>
                <span class="dot dot-on" aria-hidden="true" />
                {/* O espaço entre os dois é lido por quem extrai o texto da
                    página. Sem ele o marco vira "2026BluckerTV". Na tela não
                    muda nada: a grade é que posiciona as células. */}
                <span class="marco-ano">{obra.ano}</span>{' '}
                <span class="marco-nome">{obra.titulo}</span>
              </a>
            </li>
          ))
        }
      </ol>

      <div class="sala-corpo">
        {
          emCartaz.map((obra) => (
            <Etiqueta obra={obra} lang={lang} />
          ))
        }

        <p class="para-colecao hang">
          <span></span>
          <a class="quiet-link" href={rota(lang, '/obras')}>
            {t('colecao.verTudo')(obras.length)} <span aria-hidden="true">&#8594;</span>
          </a>
        </p>
      </div>
    </section>

    <section id="redes" class="sala wall">
      <h2 class="sala-titulo">{t('sala.redes')}</h2>
      <div class="sala-corpo">
        <!-- Cada rede é uma linha inteira, no mesmo desenho das linhas da
             coleção: o alvo de clique ocupa a largura toda, em vez de ser um
             nome curto perdido no meio de uma faixa vazia. -->
        <ul class="redes">
          {
            SOCIAL.map(({ rede, usuario, href }) => (
              <li>
                <a class="rede" href={href} rel="me noopener noreferrer" target="_blank">
                  {/* Mesmo motivo do marco acima: sem o espaço o texto
                      extraído sai "InstagramFelipe Faria". */}
                  <span class="field rede-nome">{rede}</span>{' '}
                  <span class="rede-usuario">{usuario}</span>{' '}
                  <span class="rede-seta" aria-hidden="true">
                    &#8599;
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <Rodape lang={lang} />
</Base>

<style>
  .entrada {
    padding-block: clamp(4rem, 14vh, 9rem) clamp(4rem, 10vh, 7rem);
  }

  .entrada-corpo {
    grid-column: 2 / -1;
  }

  @media (max-width: 47.99rem) {
    .entrada-corpo {
      grid-column: 1 / -1;
    }
  }

  .nome {
    font-size: clamp(2.75rem, 1.4rem + 5.4vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .linha-artista {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
  }

  /* A quebra em si vem da classe `linhas`, no global.css. Aqui fica só a
     medida, para a linha mais longa não dobrar sozinha no desktop. */
  .linha-artista span {
    max-width: 48ch;
  }

  .texto-parede {
    margin-top: 2.5rem;
    display: grid;
    gap: 1rem;
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .acervo {
    margin-top: 2.5rem;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .sala {
    padding-block: clamp(2rem, 5vh, 3.5rem) clamp(3rem, 8vh, 5rem);
  }

  /* As duas últimas salas fecham curtas. O intervalo entre elas era a soma de
     três respiros empilhados, o do link, o do fim de uma sala e o do começo da
     outra, e dava 117px de vazio. Agora eles dividem o mesmo intervalo. */
  #obras {
    padding-bottom: clamp(1rem, 2vh, 1.5rem);
  }

  #redes {
    padding-block: clamp(1.5rem, 3vh, 2rem);
  }

  /* A linha do percurso -----------------------------------------------
     Três marcos numa régua, ligados por um fio que corre atrás dos pontos.
     O fio é um pseudo-elemento da lista, com um só traço do primeiro ao último
     ponto, em vez de um pedaço por item: assim ele não depende da altura nem
     do texto de ninguém, que foi onde a tentativa anterior quebrou. */
  .percurso {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    list-style: none;
    margin: 0;
    padding: clamp(1.5rem, 3vw, 2rem) 0 clamp(1.75rem, 3.5vw, 2.5rem);
  }

  /* O fio nasce no centro do primeiro ponto e morre no centro do último, e não
     nas bordas da lista: parar no meio do marco é o que faz a régua parecer
     desenhada, e não cortada. */
  .percurso::before {
    content: '';
    position: absolute;
    top: calc(clamp(1.5rem, 3vw, 2rem) + 0.21875rem);
    left: calc(100% / 6);
    right: calc(100% / 6);
    height: 1px;
    background: var(--color-rule);
  }

  .marco {
    position: relative;
  }

  /* O marco inteiro é o alvo do clique, e leva à etiqueta correspondente
     mais abaixo na página. */
  .marco-link {
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    text-align: center;
    color: inherit;
    text-decoration: none;
  }

  .marco-link:hover .marco-nome {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.14em;
  }

  .marco-link:hover .dot {
    transform: scale(1.35);
  }

  .marco .dot {
    transition: transform 160ms ease;
  }

  /* O ponto fica acima do fio, com um halo da cor do fundo, para o traço não
     atravessar o círculo. */
  .marco .dot {
    position: relative;
    box-shadow: 0 0 0 4px var(--color-wall);
  }

  .marco-ano {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .marco-nome {
    font-family: var(--font-work);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.2;
    color: var(--color-ink);
  }

  @media (max-width: 34rem) {
    .marco-nome {
      font-size: 0.875rem;
    }

    .marco-ano {
      letter-spacing: 0.08em;
    }
  }

  /* O nome da sala é uma plaquinha, não um letreiro. Mesma tipografia
     dos campos da etiqueta, porque cumpre a mesma função. */
  .sala-titulo {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    padding-bottom: 1.25rem;
  }

  .sala-corpo {
    border-top: 1px solid var(--color-rule);
  }

  /* Disponibilidade. Mesma voz de campo da etiqueta, com o ponto vermelho na
     frente para o olho achar antes de ler. */
  .disponivel {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .disponivel .dot {
    flex: none;
  }

  /* Já teve um fio ligando os pontos das etiquetas aqui, e foi removido:
     como cada etiqueta é alta, o fio virava um traço comprido descendo o bloco
     inteiro em vez de ligar um ponto ao outro. A sequência continua sendo dada
     pela ordem em que as três aparecem. */

  .canais {
    padding-block: clamp(2rem, 4vw, 3rem) 0;
    row-gap: 0.75rem;
  }

  @media (max-width: 47.99rem) {
    .canais {
      row-gap: 0.125rem;
    }
  }

  /* Pouco embaixo: logo abaixo vem o fim da sala e o começo da próxima, e os
     três respiros somavam 117px de vazio entre o link e a sala seguinte. */
  .para-colecao {
    padding-block: clamp(2rem, 4vw, 2.75rem) clamp(0.5rem, 1vw, 0.75rem);
    border-top: 1px solid var(--color-rule);
    font-size: 0.875rem;
  }


  /* Sem respiro no topo: a seção já entrega um fio, e um segundo fio logo
     abaixo dele deixava uma faixa vazia entre os dois. A primeira rede começa
     colada nesse fio, como as linhas do catálogo fazem. */
  .redes {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .redes li:last-child .rede {
    border-bottom: 0;
  }

  /* Mesma anatomia da linha da coleção: rótulo na coluna da margem, valor no
     corpo, seta na ponta aparecendo no hover. */
  .rede {
    display: grid;
    grid-template-columns: var(--hang) minmax(0, 1fr) 1.25rem;
    align-items: baseline;
    gap: 0 var(--gutter);
    /* O respiro lateral entra aqui, e não fora, para o realce do hover cobrir
       a linha inteira e a seta ficar dentro dele em vez de escapar na borda. */
    padding: 0.9rem 1rem;
    margin-inline: -1rem;
    border-bottom: 1px solid var(--color-rule);
    color: inherit;
    text-decoration: none;
    transition: background-color 160ms ease;
  }


  .rede:hover {
    background-color: var(--color-paper);
  }

  .rede-nome {
    padding-top: 0;
  }

  .rede-usuario {
    font-size: 1.0625rem;
    color: var(--color-ink);
  }

  .rede-seta {
    justify-self: end;
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    opacity: 0;
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .rede:hover .rede-seta {
    opacity: 1;
    transform: translate(2px, -2px);
  }

  @media (max-width: 47.99rem) {
    .rede {
      grid-template-columns: minmax(0, 1fr) 1.25rem;
      row-gap: 0.2rem;
    }

    .rede-nome {
      grid-column: 1 / -1;
      margin-top: 0;
    }
  }
</style>
