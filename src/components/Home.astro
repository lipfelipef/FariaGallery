---
import Base from '../layouts/Base.astro';
import Topo from './Topo.astro';
import Rodape from './Rodape.astro';
import Etiqueta from './Etiqueta.astro';
import { OBRAS } from '../data/obras';
import { SITE, type Locale } from '../consts';
import { traduzir } from '../i18n/ui';
import { rota } from '../i18n/utils';
import { obrasComEstudo } from '../lib/estudos';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = traduzir(lang);

/** Obra só vira link quando existe estudo escrito naquele idioma. */
const comEstudo = await obrasComEstudo(lang);

/**
 * Obra sem ficha preenchida não vai pra parede. Some do site inteiro
 * enquanto estiver marcada como `pendente`, e volta quando o campo sai.
 */
const acervo = OBRAS.filter((o) => !o.pendente);
const comCodigo = acervo.filter((o) => o.estado === 'publico').length;

/**
 * A home é a exposição, não o acervo. Só as obras marcadas como destaque
 * ficam penduradas aqui, com a ficha inteira. O resto vive na coleção, que
 * é o catálogo e aguenta 50 obras sem virar rolagem infinita.
 */
const emCartaz = acervo.filter((o) => o.destaque);

---

<Base lang={lang} descricao={t('meta.home')}>
  <Topo lang={lang} />

  <main id="conteudo">
    <!-- Parede de entrada: no museu é o texto que abre a exposição. -->
    <section class="entrada wall hang">
      <div class="entrada-corpo entrance">
        <h1 class="nome">{SITE.name}</h1>
        <p class="linha-artista">{t('artista')}</p>

        <div class="texto-parede">
          <p>{t('parede.1')}</p>
          <p>{t('parede.2')}</p>
        </div>

        <p class="acervo">{t('acervo')(acervo.length, comCodigo)}</p>
      </div>
    </section>

    <section id="obras" class="sala wall">
      <h2 class="sala-titulo">{t('sala.emCartaz')}</h2>
      <div class="sala-corpo">
        {
          emCartaz.map((obra) => (
            <Etiqueta obra={obra} lang={lang} temEstudo={comEstudo.has(obra.slug)} />
          ))
        }

        <p class="para-colecao hang">
          <span></span>
          <a class="quiet-link" href={rota(lang, '/obras')}>
            {t('colecao.verTudo')(acervo.length)} <span aria-hidden="true">&#8594;</span>
          </a>
        </p>
      </div>
    </section>

  </main>

  <Rodape lang={lang} />
</Base>

<style>
  .entrada {
    padding-block: clamp(4rem, 14vh, 9rem) clamp(4rem, 10vh, 7rem);
  }

  .entrada-corpo {
    grid-column: 2 / -1;
  }

  @media (max-width: 47.99rem) {
    .entrada-corpo {
      grid-column: 1 / -1;
    }
  }

  .nome {
    font-size: clamp(2.75rem, 1.4rem + 5.4vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .linha-artista {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
    max-width: 34ch;
  }

  .texto-parede {
    margin-top: 2.5rem;
    display: grid;
    gap: 1rem;
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .acervo {
    margin-top: 2.5rem;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .sala {
    padding-block: clamp(2rem, 5vh, 3.5rem) clamp(3rem, 8vh, 5rem);
  }

  /* O nome da sala é uma plaquinha, não um letreiro. Mesma tipografia
     dos campos da etiqueta, porque cumpre a mesma função. */
  .sala-titulo {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    padding-bottom: 1.25rem;
  }

  .sala-corpo {
    border-top: 1px solid var(--color-rule);
  }

  .canais {
    padding-block: clamp(2rem, 4vw, 3rem) 0;
    row-gap: 0.75rem;
  }

  @media (max-width: 47.99rem) {
    .canais {
      row-gap: 0.125rem;
    }
  }

  .para-colecao {
    padding-block: clamp(2rem, 4vw, 2.75rem);
    border-top: 1px solid var(--color-rule);
    font-size: 0.875rem;
  }

  .curriculo {
    padding-block: 1.75rem clamp(2rem, 4vw, 3rem);
  }

  /* Botão de verdade, não link de texto: currículo é a ação que o
     recrutador procura, e precisa de alvo grande e contorno visível.
     Inverte no hover em vez de acender uma cor que não existe no site. */
  .botao {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    border: 1px solid var(--color-ink);
    padding: 0.85rem 1.35rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }

  .botao:hover {
    background-color: var(--color-ink);
    color: var(--color-wall);
  }

  .botao-seta {
    font-size: 0.875rem;
    transition: transform 180ms ease;
  }

  .botao:hover .botao-seta {
    transform: translateY(2px);
  }
</style>
