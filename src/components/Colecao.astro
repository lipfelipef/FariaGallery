---
import Base from '../layouts/Base.astro';
import Topo from './Topo.astro';
import Rodape from './Rodape.astro';
import { doTipo, ordemDoAno, anoExibido, inicioDaObra } from '../data/obras';
import { tempoRelativo } from '../lib/tempo';
import type { Locale } from '../consts';
import { traduzir } from '../i18n/ui';
import { rota } from '../i18n/utils';
import { postsPorObra } from '../lib/blog';

interface Props {
  lang: Locale;
  /** `obra` monta a coleção, `experiencia` monta a outra sala. */
  tipo?: 'obra' | 'experiencia';
}

const { lang, tipo = 'obra' } = Astro.props;
const t = traduzir(lang);
const textos = await postsPorObra(lang);

const acervo = doTipo(tipo);
const titulo = tipo === 'obra' ? t('colecao.titulo') : t('experiencia.titulo');
/** Aparece na página. Curta e direta. */
const chamada = tipo === 'obra' ? t('colecao.chamada') : t('experiencia.chamada');
/** Aparece no resultado de busca. Mais longa e com as palavras que se procura. */
const descricao = tipo === 'obra' ? t('meta.colecao') : t('meta.experiencia');

/**
 * O catálogo de museu agrupa por ano e vai do mais novo para o mais antigo.
 * O ano na margem vira a espinha cronológica: dá para ler a trajetória
 * descendo a página, sem abrir nada.
 */
const anos = [...new Set(acervo.map((o) => o.ano))].sort(
  (a, b) =>
    ordemDoAno(acervo.find((o) => o.ano === b)!) - ordemDoAno(acervo.find((o) => o.ano === a)!)
);

/**
 * Cada grupo mostra o ano e, embaixo, há quanto tempo foi. O ano diz quando,
 * o relativo diz o quão longe: "2024" não conta nada sozinho para quem lê
 * daqui a cinco anos, "há 2 anos" conta.
 */
const porAno = anos.map((ano) => {
  const obras = acervo.filter((o) => o.ano === ano);
  const primeira = obras[0];
  const inicio = inicioDaObra(primeira) ?? new Date(`${ano}-01-01T12:00:00Z`);
  return {
    ano,
    rotulo: anoExibido(primeira, t('tempo.atualmente')),
    relativo: primeira.ativa ? undefined : tempoRelativo(inicio, lang),
    obras,
  };
});

/** Etiquetas com contagem, da mais usada para a menos. Só aparece quem tem 1+. */
const contagem = new Map<string, number>();
for (const obra of acervo) {
  for (const tag of obra.tags) contagem.set(tag, (contagem.get(tag) ?? 0) + 1);
}
const tags = [...contagem.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

/** A linha leva ao texto da obra, se houver. Senão, ao repositório dela. */
const destino = (slug: string, href?: string) => {
  const post = textos.get(slug);
  return post ? rota(lang, `/blog/${post}`) : href;
};
---

<Base lang={lang} titulo={titulo} descricao={descricao}>
  <Topo lang={lang} />

  <main id="conteudo">
    <section class="abertura wall hang">
      <div class="abertura-corpo">
        <h1 class="titulo-sala">{titulo}</h1>
        <p class="chamada">{chamada}</p>
      </div>
    </section>

    <section class="wall">
      <div class="filtro hang" data-filtro>
        <p class="field">{t('colecao.filtrar')}</p>
        <div>
          <div class="etiquetas">
            <button class="etiqueta etiqueta-ativa" type="button" data-tag="" aria-pressed="true">
              {t('colecao.todas')} <span class="etiqueta-n">{acervo.length}</span>
            </button>
            {
              tags.map(([tag, n]) => (
                <button class="etiqueta" type="button" data-tag={tag} aria-pressed="false">
                  {tag} <span class="etiqueta-n">{n}</span>
                </button>
              ))
            }
          </div>
          <p class="contagem" data-contagem>{t('colecao.contagem')(acervo.length, acervo.length)}</p>
        </div>
      </div>

      <div class="catalogo">
        {
          porAno.map(({ rotulo, relativo, obras }) => (
            <section class="grupo hang" data-grupo>
              <p class="ano">
                {rotulo}
                {relativo && <span class="ano-relativo">{relativo}</span>}
              </p>
              <ul class="linhas">
                {obras.map((obra) => (
                  <li class="linha" data-tags={obra.tags.join(',')}>
                    <a class="linha-link" href={destino(obra.slug, obra.link?.href)}>
                      <span
                        class:list={['dot', obra.estado !== 'encerrado' ? 'dot-on' : 'dot-off']}
                        aria-hidden="true"
                      />
                      <span class="linha-titulo">{obra.titulo}</span>
                      <span class="linha-meio">{obra.meio}</span>
                      <span class="linha-seta" aria-hidden="true">
                        &#8594;
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
        <p class="vazio" data-vazio hidden>{t('colecao.nada')}</p>
      </div>
    </section>
  </main>

  <Rodape lang={lang} />
</Base>

<script is:inline define:vars={{ textoContagem: { um: t('colecao.contagem')(1, 2).replace(/\d+/g, '#') } }}>
  (function () {
    var filtro = document.querySelector('[data-filtro]');
    if (!filtro) return;
    var botoes = filtro.querySelectorAll('.etiqueta');
    var linhas = document.querySelectorAll('.linha');
    var grupos = document.querySelectorAll('[data-grupo]');
    var contagem = document.querySelector('[data-contagem]');
    var vazio = document.querySelector('[data-vazio]');
    var total = linhas.length;
    var molde = contagem ? contagem.textContent : '';

    function aplicar(tag) {
      var visiveis = 0;
      linhas.forEach(function (linha) {
        var tags = (linha.getAttribute('data-tags') || '').split(',');
        var mostra = !tag || tags.indexOf(tag) !== -1;
        linha.hidden = !mostra;
        if (mostra) visiveis++;
      });

      // Ano sem nenhuma obra visível some junto, senão sobra rótulo solto.
      grupos.forEach(function (grupo) {
        var algum = grupo.querySelectorAll('.linha:not([hidden])').length > 0;
        grupo.hidden = !algum;
      });

      if (contagem) {
        contagem.textContent =
          visiveis === total ? molde : molde.replace(String(total), visiveis + ' / ' + total);
      }
      if (vazio) vazio.hidden = visiveis > 0;

      botoes.forEach(function (b) {
        var ativo = (b.getAttribute('data-tag') || '') === tag;
        b.classList.toggle('etiqueta-ativa', ativo);
        b.setAttribute('aria-pressed', String(ativo));
      });
    }

    botoes.forEach(function (b) {
      b.addEventListener('click', function () {
        var tag = b.getAttribute('data-tag') || '';
        // Clicar de novo na etiqueta ativa desliga o filtro.
        aplicar(b.classList.contains('etiqueta-ativa') ? '' : tag);
      });
    });
  })();
</script>

<style>
  .abertura {
    padding-block: clamp(3rem, 10vh, 6rem) clamp(2rem, 6vh, 3.5rem);
  }

  .abertura-corpo {
    grid-column: 2 / -1;
  }

  @media (max-width: 47.99rem) {
    .abertura-corpo {
      grid-column: 1 / -1;
    }
  }

  .titulo-sala {
    font-size: clamp(2rem, 1.2rem + 3vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .chamada {
    margin-top: 1rem;
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  /* Filtro ------------------------------------------------------- */

  .filtro {
    padding-block: 0 1.75rem;
    border-bottom: 1px solid var(--color-rule);
    row-gap: 0.75rem;
  }

  .etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .etiqueta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    background: none;
    border: 1px solid var(--color-rule);
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.75rem;
    color: var(--color-ink-soft);
    transition:
      border-color 180ms ease,
      color 180ms ease,
      background-color 180ms ease;
  }

  .etiqueta:hover {
    border-color: var(--color-ink-soft);
    color: var(--color-ink);
  }

  .etiqueta-ativa {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-wall);
  }

  .etiqueta-n {
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  .contagem {
    margin-top: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* Catálogo ----------------------------------------------------- */

  .grupo {
    padding-block: 2rem 0.5rem;
  }

  .grupo[hidden] {
    display: none;
  }

  /* O ano na margem é a espinha cronológica da página. */
  .ano {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
    padding-top: 0.85rem;
  }

  .ano-relativo {
    display: block;
    margin-top: 0.2rem;
    font-weight: 400;
    font-size: 0.75rem;
    opacity: 0.75;
  }

  .linhas {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .linha[hidden] {
    display: none;
  }

  /* A linha inteira é clicável: alvo grande, sem caça ao link. */
  .linha-link {
    display: grid;
    grid-template-columns: 0.75rem minmax(0, 1fr) auto 1.25rem;
    align-items: baseline;
    gap: 0 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--color-rule);
    color: inherit;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .linha-link:hover {
    background-color: var(--color-paper);
  }

  .linha-link:hover .linha-seta {
    opacity: 1;
    transform: translateX(2px);
  }

  .linha-titulo {
    font-family: var(--font-work);
    font-style: italic;
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .linha-meio {
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
    text-align: right;
  }

  .linha-seta {
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    opacity: 0;
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  @media (max-width: 47.99rem) {
    .linha-link {
      grid-template-columns: 0.75rem minmax(0, 1fr);
      row-gap: 0.25rem;
    }

    .linha-meio {
      grid-column: 2;
      text-align: left;
    }

    .linha-seta {
      display: none;
    }
  }

  .vazio {
    padding-block: 3rem;
    color: var(--color-ink-soft);
    font-size: 1rem;
  }
</style>
