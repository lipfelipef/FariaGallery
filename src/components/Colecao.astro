---
import Base from '../layouts/Base.astro';
import Topo from './Topo.astro';
import Rodape from './Rodape.astro';
import TempoVivo from './TempoVivo.astro';
import { doTipo, ordemDoAno, anoExibido, meioDe, tagDe } from '../data/obras';
import { fichaDaObra } from '../lib/ficha';
import { anosAtras } from '../lib/tempo';
import { LIMITE_FILTROS, FOLGA_FILTROS, type Locale } from '../consts';
import { traduzir } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = traduzir(lang);

/**
 * Só a coleção.
 *
 * Este componente também montava a sala de experiência, com o mesmo filtro e a
 * mesma ficha recolhida, e ela ganhou componente próprio em 11/08/2026: tem
 * uma entrada só, e catálogo de um item é uma lista com filtro que não filtra
 * nada. Ver `Experiencia.astro`.
 */
const acervo = doTipo('obra');
const titulo = t('colecao.titulo');
/** Aparece na página. Curta e direta. */
const chamada = t('colecao.chamada');
/** Aparece no resultado de busca. Mais longa e com as palavras que se procura. */
const descricao = t('meta.colecao');

/**
 * O catálogo de museu agrupa por ano e vai do mais novo para o mais antigo.
 * O ano na margem vira a espinha cronológica: dá para ler a trajetória
 * descendo a página, sem abrir nada.
 *
 * A chave é o próprio ano, com o meio ponto que `ordemDoAno` acrescenta a obra
 * em andamento para ela ficar acima das que fecharam no mesmo ano.
 */
const chaveDoGrupo = (ano: string) => ordemDoAno(acervo.find((o) => o.ano === ano)!);

const anos = [...new Set(acervo.map((o) => o.ano))].sort((a, b) => chaveDoGrupo(b) - chaveDoGrupo(a));

const porAno = anos.map((ano) => {
  const obras = acervo.filter((o) => o.ano === ano);
  const primeira = obras[0];

  return {
    ano,
    rotulo: anoExibido(primeira, t('tempo.atualmente')),
    /**
     * A linha embaixo do ano, respondendo "há quanto tempo foi": este ano, ano
     * passado, há 2 anos. O ano diz quando, o relativo diz o quão longe:
     * "2024" não conta nada sozinho para quem lê daqui a cinco anos.
     *
     * Obra em andamento fica sem ela, porque o rótulo dela já termina em
     * "atualmente" e as duas diriam a mesma coisa em sequência.
     */
    relativo: primeira.ativa ? undefined : anosAtras(Number.parseInt(ano, 10), lang),
    /**
     * O ano em número, para o navegador refazer o relativo sozinho. Sem isto o
     * texto envelhece: o site é estático, então em 1º de janeiro a página
     * continuaria dizendo que o ano anterior é "este ano".
     */
    anoNumero: primeira.ativa ? undefined : Number.parseInt(ano, 10),
    obras,
  };
});

/**
 * Etiquetas com contagem, da mais usada para a menos.
 *
 * O desempate é a obra mais nova que carrega aquela etiqueta, e não a ordem
 * alfabética: com contagem empatada, o alfabeto poria "Angular" na frente de
 * "Python" por motivo nenhum, e o corte das que ficam à vista cairia sempre
 * no fim do dicionário. `porAno` já está do mais novo para o mais antigo.
 */
const ordemDaObra = new Map(porAno.flatMap((g) => g.obras).map((o, i) => [o.slug, i]));
const contagem = new Map<string, number>();
const maisNova = new Map<string, number>();
for (const obra of acervo) {
  for (const tag of obra.tags) {
    contagem.set(tag, (contagem.get(tag) ?? 0) + 1);
    const posicao = ordemDaObra.get(obra.slug) ?? Number.MAX_SAFE_INTEGER;
    if (posicao < (maisNova.get(tag) ?? Number.MAX_SAFE_INTEGER)) maisNova.set(tag, posicao);
  }
}
const tags = [...contagem.entries()].sort(
  (a, b) => b[1] - a[1] || maisNova.get(a[0])! - maisNova.get(b[0])! || a[0].localeCompare(b[0])
);

/**
 * Quantas ficam à vista. A ordenação acima já pôs as mais usadas na frente,
 * então o corte cai sempre nas mais raras, que são as que menos ajudam a
 * achar alguma coisa. Enquanto a lista inteira couber sem incomodar, ela sai
 * inteira: recolher duas etiquetas custa mais do que mostrar as duas.
 */
const cabemTodas = tags.length <= LIMITE_FILTROS + FOLGA_FILTROS;
const aVista = cabemTodas ? tags.length : LIMITE_FILTROS;
const recolhidas = tags.length - aVista;

/**
 * O texto da contagem com filtro ligado, pronto para o navegador preencher.
 *
 * O servidor escreve "7 obras", que é o caso sem filtro. Quando alguém clica
 * numa etiqueta, quem reescreve a frase é o script, e ele não tem o dicionário:
 * scripts `is:inline` recebem só o que passa por `define:vars`.
 *
 * Então a frase sai daqui pronta, chamando a mesma função de tradução com dois
 * números impossíveis e trocando cada um por uma marca. Assim o "de", o "of" e
 * o "de" do espanhol continuam vindo do dicionário, e o script só encaixa os
 * dois números.
 *
 * Os números precisam ser diferentes entre si (senão a função cai no ramo sem
 * filtro) e não podem aparecer no resto da frase, que é por que são grandes.
 */
const N = 987654321;
const T = 123456789;
const moldeFiltrado = t('colecao.contagem')(N, T)
  .replace(String(N), '{n}')
  .replace(String(T), '{t}');

---

<Base lang={lang} titulo={titulo} descricao={descricao}>
  <Topo lang={lang} />

  <main id="conteudo">
    <section class="abertura wall hang">
      <div class="abertura-corpo">
        <h1 class="titulo-sala">{titulo}</h1>
        <p class="chamada linhas">
          {chamada.map((linha, i) => (<>{i > 0 && ' '}<span>{linha}</span></>))}
        </p>
      </div>
    </section>

    <section class="wall">
      <div class="filtro hang" data-filtro>
        <p class="field">{t('colecao.filtrar')}</p>
        <div>
          <div class="etiquetas">
            <button class="etiqueta etiqueta-ativa" type="button" data-tag="" aria-pressed="true">
              {t('colecao.todas')} <span class="etiqueta-n">{acervo.length}</span>
            </button>
            {
              tags.map(([tag, n], i) => (
                <button
                  class="etiqueta"
                  type="button"
                  data-tag={tag}
                  aria-pressed="false"
                  hidden={i >= aVista}
                  data-recolhida={i >= aVista ? '' : undefined}
                >
                  {tagDe(tag, lang)} <span class="etiqueta-n">{n}</span>
                </button>
              ))
            }
            {
              recolhidas > 0 && (
                <button class="etiqueta etiqueta-mais" type="button" data-mais aria-expanded="false">
                  {t('filtro.mais')(recolhidas)}
                </button>
              )
            }
          </div>
          <p class="contagem" data-contagem>{t('colecao.contagem')(acervo.length, acervo.length)}</p>
        </div>
      </div>

      <div class="catalogo">
        {
          porAno.map(({ rotulo, relativo, obras, anoNumero }) => (
            <section class="grupo hang" data-grupo>
              <p class="ano">
                {rotulo}
                {relativo && (
                  <span class="ano-relativo" data-ano={anoNumero}>
                    {relativo}
                  </span>
                )}
              </p>
              <ul class="linhas">
                {obras.map((obra) => (
                  <li class="linha" data-tags={obra.tags.join(',')}>
                    {/*
                      A linha leva direto ao destino da obra: o repositório, o
                      canal ou o site. Abre em aba nova porque sai daqui.

                      Sem destino ela não vira link nenhum, e a seta some
                      junto. `<a>` sem `href` não é link: não recebe foco, não
                      abre com Enter, e a seta ficaria prometendo uma saída que
                      não existe. Hoje as nove obras têm destino, mas o campo é
                      opcional, e a próxima pode não ter.
                    */}
                    {obra.link ? (
                      <a
                        class="linha-link"
                        href={obra.link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <span class="dot dot-on" aria-hidden="true" />
                        {/* Cada célula é um span e o afastamento vem da grade,
                            então sem um espaço escrito aqui o texto extraído da
                            página sai "BluckerAngular 19, Node.js, Express". */}
                        <span class="linha-titulo">{obra.titulo}</span>{' '}
                        <span class="linha-meio">{meioDe(obra, lang)}</span>{' '}
                        <span class="linha-seta" aria-hidden="true">
                          &#8599;
                        </span>
                      </a>
                    ) : (
                      <span class="linha-link">
                        <span class="dot dot-on" aria-hidden="true" />
                        <span class="linha-titulo">{obra.titulo}</span>{' '}
                        <span class="linha-meio">{meioDe(obra, lang)}</span>
                      </span>
                    )}

                    {/*
                      A ficha inteira, recolhida.

                      Até aqui, papel e crédito só existiam na etiqueta da
                      home, e a home mostra três obras. Quem é dessas três
                      tinha ficha; o resto tinha o nome e a stack, e o que
                      estava escrito sobre elas não aparecia em lugar nenhum
                      do site: havia obra com milhões de visualizações escritas
                      num campo que ninguém lia.

                      É `details` do próprio HTML, e não um botão com script:
                      abre sem JavaScript, já vem com o estado certo para o
                      leitor de tela e o navegador cuida de tudo. O link da
                      linha continua onde estava, levando ao texto: quem quer
                      ler clica no título, quem quer a ficha abre aqui.
                    */}
                    <details class="ficha-recolhida">
                      <summary class="ficha-abre">{t('colecao.ficha')}</summary>
                      <dl class="ficha">
                        {fichaDaObra(obra, lang).map(({ campo, linhas, medida, vivo }) => (
                          <>
                            <dt class="field">{campo}</dt>
                            {/* `data-vivo` marca a conta de tempo que ainda
                                corre, para o `TempoVivo` refazer o número. */}
                            <dd
                              data-vivo={vivo}
                              class:list={[
                                'value',
                                'linhas',
                                linhas.length > 1 && 'value-linhas',
                                medida && 'value-medida',
                              ]}
                            >
                              {linhas.map((linha, i) => (
                                <>
                                  {i > 0 && ' '}
                                  <span>{linha}</span>
                                </>
                              ))}
                            </dd>
                          </>
                        ))}
                      </dl>
                    </details>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
        <p class="vazio" data-vazio hidden>{t('colecao.nada')}</p>
      </div>
    </section>
  </main>

  <Rodape lang={lang} />
</Base>

<TempoVivo lang={lang} />

<script
  is:inline
  define:vars={{
    moldeFiltrado,
    rotuloMais: recolhidas > 0 ? t('filtro.mais')(recolhidas) : '',
    rotuloMenos: t('filtro.menos'),
  }}
>
  (function () {
    var filtro = document.querySelector('[data-filtro]');
    if (!filtro) return;
    // Só os que filtram de verdade. O botão que abre o resto também tem a
    // classe `etiqueta`, porque é o mesmo objeto de vidro na parede, mas ele
    // não é um filtro e não pode entrar nesta lista.
    var botoes = filtro.querySelectorAll('.etiqueta[data-tag]');
    var linhas = document.querySelectorAll('.linha');
    var grupos = document.querySelectorAll('[data-grupo]');
    var contagem = document.querySelector('[data-contagem]');
    var vazio = document.querySelector('[data-vazio]');
    var total = linhas.length;
    var molde = contagem ? contagem.textContent : '';

    function aplicar(tag) {
      var visiveis = 0;
      linhas.forEach(function (linha) {
        var tags = (linha.getAttribute('data-tags') || '').split(',');
        var mostra = !tag || tags.indexOf(tag) !== -1;
        linha.hidden = !mostra;
        if (mostra) visiveis++;
      });

      // Ano sem nenhuma obra visível some junto, senão sobra rótulo solto.
      grupos.forEach(function (grupo) {
        var algum = grupo.querySelectorAll('.linha:not([hidden])').length > 0;
        grupo.hidden = !algum;
      });

      if (contagem) {
        contagem.textContent =
          visiveis === total
            ? molde
            : moldeFiltrado.replace('{n}', visiveis).replace('{t}', total);
      }
      if (vazio) vazio.hidden = visiveis > 0;

      botoes.forEach(function (b) {
        var ativo = (b.getAttribute('data-tag') || '') === tag;
        b.classList.toggle('etiqueta-ativa', ativo);
        b.setAttribute('aria-pressed', String(ativo));
      });
    }

    botoes.forEach(function (b) {
      b.addEventListener('click', function () {
        var tag = b.getAttribute('data-tag') || '';
        // Clicar de novo na etiqueta ativa desliga o filtro.
        aplicar(b.classList.contains('etiqueta-ativa') ? '' : tag);
      });
    });

    /* As etiquetas raras, e o botão que as chama.
       Recolher nunca esconde a etiqueta que está filtrando a página: sumir
       com o filtro em uso deixaria a lista curta sem explicação na tela. */
    var mais = filtro.querySelector('[data-mais]');
    if (!mais) return;
    var recolhiveis = filtro.querySelectorAll('[data-recolhida]');
    var aberto = false;

    mais.addEventListener('click', function () {
      aberto = !aberto;
      recolhiveis.forEach(function (b) {
        b.hidden = !aberto && !b.classList.contains('etiqueta-ativa');
      });
      mais.textContent = aberto ? rotuloMenos : rotuloMais;
      mais.setAttribute('aria-expanded', String(aberto));
    });
  })();
</script>

<style>
  .abertura {
    padding-block: clamp(3rem, 10vh, 6rem) clamp(2rem, 6vh, 3.5rem);
  }

  .abertura-corpo {
    grid-column: 2 / -1;
  }

  @media (max-width: 47.99rem) {
    .abertura-corpo {
      grid-column: 1 / -1;
    }
  }

  .titulo-sala {
    font-size: clamp(2rem, 1.2rem + 3vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .chamada {
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  /* A quebra vem da classe `linhas`. A medida acompanha a linha mais longa
     dos três idiomas, senão ela dobraria e desfaria a quebra no desktop. */
  .chamada span {
    max-width: 68ch;
  }

  /* Filtro ------------------------------------------------------- */

  .filtro {
    padding-block: 0 1.75rem;
    border-bottom: 1px solid var(--color-rule);
    row-gap: 0.75rem;
  }

  .etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .etiqueta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    background: none;
    border: 1px solid var(--color-rule);
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.75rem;
    color: var(--color-ink-soft);
    transition:
      border-color 180ms ease,
      color 180ms ease,
      background-color 180ms ease;
  }

  .etiqueta:hover {
    border-color: var(--color-ink-soft);
    color: var(--color-ink);
  }

  /* Sem isto o `hidden` não esconde nada: o atributo vale `display: none` na
     folha do navegador, e qualquer `display` escrito aqui ganha dele. */
  .etiqueta[hidden] {
    display: none;
  }

  .etiqueta-ativa {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-wall);
  }

  /* Não é etiqueta de assunto, é a chave que abre a gaveta. Sem moldura, para
     não ser confundida com um filtro a mais. */
  .etiqueta-mais {
    border-color: transparent;
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 0.25em;
  }

  .etiqueta-mais:hover {
    border-color: transparent;
    text-decoration-color: var(--color-ink);
  }

  .etiqueta-n {
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  .contagem {
    margin-top: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* Catálogo ----------------------------------------------------- */

  .grupo {
    padding-block: 2rem 0.5rem;
  }

  /* O último grupo encostava no fio do rodapé, a 8px, e aquele fio é mais
     largo e começa mais à esquerda que tudo no catálogo, então destoava.
     Agora o catálogo fecha com um fio da mesma medida do que o abre, embaixo
     do filtro, e só depois vem o espaço até o rodapé. */
  .catalogo {
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }

  /* Sem isto seriam dois fios quase colados: o da última obra e o de baixo. */
  .grupo:last-of-type .linha:last-of-type {
    border-bottom: 0;
  }

  .grupo[hidden] {
    display: none;
  }

  /* O ano na margem é a espinha cronológica da página. */
  .ano {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
    padding-top: 0.85rem;
  }

  .ano-relativo {
    display: block;
    margin-top: 0.2rem;
    font-weight: 400;
    font-size: 0.75rem;
    opacity: 0.75;
  }

  .linhas {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .linha[hidden] {
    display: none;
  }

  /* O fio agora fecha a linha inteira, e não só o link: abaixo dele vem a
     ficha recolhida, e o fio no meio cortaria a obra ao meio quando aberta. */
  .linha {
    border-bottom: 1px solid var(--color-rule);
  }

  /* A linha inteira é clicável: alvo grande, sem caça ao link. */
  .linha-link {
    display: grid;
    grid-template-columns: 0.75rem minmax(0, 1fr) auto 1.25rem;
    align-items: baseline;
    gap: 0 1rem;
    padding-block: 0.85rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  /* A ficha recolhida ------------------------------------------------- */

  /* O gesto de abrir, na mesma tipografia miúda dos campos da etiqueta: é
     rótulo de sala, não botão de aplicativo. Fica alinhado com o título, na
     segunda coluna, e some de vista até alguém procurar por ele. */
  .ficha-abre {
    display: inline-block;
    margin-left: 1.75rem;
    margin-bottom: 0.85rem;
    padding: 0.15rem 0;
    cursor: pointer;
    list-style: none;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    transition: color 200ms ease;
  }

  /* O triângulo padrão do navegador sai; entra um sinal que segue a
     tipografia do resto. `::-webkit-details-marker` cobre os navegadores
     antigos que ignoram `list-style: none` no summary. */
  .ficha-abre::-webkit-details-marker {
    display: none;
  }

  .ficha-abre::before {
    content: '+';
    display: inline-block;
    width: 0.9rem;
    font-weight: 400;
  }

  .ficha-recolhida[open] .ficha-abre::before {
    content: '\2212'; /* menos de verdade, não hífen: o mesmo peso do + */
  }

  .ficha-abre:hover {
    color: var(--color-ink);
  }

  .ficha-recolhida[open] .ficha-abre {
    color: var(--color-ink);
  }

  /* A ficha em si, recuada até a altura do título, com o campo na margem
     como em toda etiqueta do site. */
  .ficha {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    column-gap: var(--gutter);
    row-gap: 0.4rem;
    margin-left: 1.75rem;
    padding-bottom: 1.5rem;
  }

  @media (max-width: 47.99rem) {
    .ficha {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.125rem;
      margin-left: 0;
    }

    .ficha-abre {
      margin-left: 0;
    }
  }

  /* Só a linha que é link acende no passar do mouse. A que não tem destino
     usa a mesma grade para ficar alinhada com as outras, mas não pode fingir
     que é clicável. */
  a.linha-link:hover {
    background-color: var(--color-paper);
  }

  a.linha-link:hover .linha-seta {
    opacity: 1;
    transform: translateX(2px);
  }

  .linha-titulo {
    font-family: var(--font-work);
    font-style: italic;
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .linha-meio {
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
    text-align: right;
  }


  .linha-seta {
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    opacity: 0;
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  @media (max-width: 47.99rem) {
    .linha-link {
      grid-template-columns: 0.75rem minmax(0, 1fr);
      row-gap: 0.25rem;
    }

    .linha-meio {
      grid-column: 2;
      text-align: left;
    }

    .linha-seta {
      display: none;
    }
  }

  .vazio {
    padding-block: 3rem;
    color: var(--color-ink-soft);
    font-size: 1rem;
  }
</style>
