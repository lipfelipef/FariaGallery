---
import Base from '../layouts/Base.astro';
import Topo from './Topo.astro';
import Rodape from './Rodape.astro';
import { doTipo, ordemDoAno, anoExibido, inicioDaObra, fimDaObra, meioDe, tagDe } from '../data/obras';
import { anosAtras, duracao, ROTULOS_DURACAO } from '../lib/tempo';
import { LOCALE_DATA } from '../i18n/utils';
import { LIMITE_FILTROS, FOLGA_FILTROS, type Locale } from '../consts';
import { traduzir } from '../i18n/ui';
import { rota } from '../i18n/utils';
import { postsPorObra } from '../lib/blog';

interface Props {
  lang: Locale;
  /** `obra` monta a coleção, `experiencia` monta a outra sala. */
  tipo?: 'obra' | 'experiencia';
}

const { lang, tipo = 'obra' } = Astro.props;
const t = traduzir(lang);
const textos = await postsPorObra(lang);

const acervo = doTipo(tipo);
const titulo = tipo === 'obra' ? t('colecao.titulo') : t('experiencia.titulo');
/** Aparece na página. Curta e direta. */
const chamada = tipo === 'obra' ? t('colecao.chamada') : t('experiencia.chamada');
/** Aparece no resultado de busca. Mais longa e com as palavras que se procura. */
const descricao = tipo === 'obra' ? t('meta.colecao') : t('meta.experiencia');

/**
 * O catálogo de museu agrupa por ano e vai do mais novo para o mais antigo.
 * O ano na margem vira a espinha cronológica: dá para ler a trajetória
 * descendo a página, sem abrir nada.
 */
/**
 * Chave de ordenação do grupo: `ordemSala` manda quando existe, senão vale o
 * ano. Como o valor de `ordemSala` é pequeno (1, 2, 3) e o do ano é grande
 * (2026), o sinal negativo é o que faz os dois conviverem na mesma ordenação
 * decrescente sem um atropelar o outro.
 */
const chaveDoGrupo = (ano: string) => {
  const obra = acervo.find((o) => o.ano === ano)!;
  return obra.ordemSala !== undefined ? -obra.ordemSala : ordemDoAno(obra) - 100000;
};

const anos = [...new Set(acervo.map((o) => o.ano))].sort((a, b) => chaveDoGrupo(b) - chaveDoGrupo(a));

/**
 * Cada grupo mostra o ano e, embaixo, há quanto tempo foi. O ano diz quando,
 * o relativo diz o quão longe: "2024" não conta nada sozinho para quem lê
 * daqui a cinco anos, "há 2 anos" conta.
 */
/**
 * A linha embaixo do ano.
 *
 * Na coleção ela responde "há quanto tempo foi": este ano, ano passado, há 2
 * anos. Na experiência responde "quanto tempo durou": 3 anos e 3 meses. Mesmo
 * lugar e mesma tipografia, porque nos dois casos é a mesma pergunta do
 * visitante, a distância no tempo.
 *
 * Na experiência cada grupo é um período próprio, então a duração é a da
 * primeira obra dele.
 */
const porAno = anos.map((ano) => {
  const obras = acervo.filter((o) => o.ano === ano);
  const primeira = obras[0];
  const inicio = inicioDaObra(primeira);
  const fim = fimDaObra(primeira);

  const abaixoDoAno =
    tipo === 'experiencia'
      ? inicio && duracao(inicio, fim, lang)
      : primeira.ativa
        ? undefined
        : anosAtras(Number.parseInt(ano, 10), lang);

  return {
    ano,
    rotulo: anoExibido(primeira, t('tempo.atualmente')),
    relativo: abaixoDoAno,
    /**
     * O que o navegador precisa para refazer a conta sozinho. Sem isto o texto
     * envelhece: o site é estático, então o número é o do último build, e um
     * canal que continua rodando ficaria parado no tempo até o próximo deploy.
     * Só entra em quem ainda corre; período fechado não muda mais.
     */
    vivo: tipo === 'experiencia' && !fim && inicio ? inicio.toISOString() : undefined,
    anoNumero: tipo === 'experiencia' || primeira.ativa ? undefined : Number.parseInt(ano, 10),
    obras,
  };
});

/**
 * Etiquetas com contagem, da mais usada para a menos.
 *
 * O desempate é a obra mais nova que carrega aquela etiqueta, e não a ordem
 * alfabética: com contagem empatada, o alfabeto poria "Angular" na frente de
 * "Python" por motivo nenhum, e o corte das que ficam à vista cairia sempre
 * no fim do dicionário. `porAno` já está do mais novo para o mais antigo.
 */
const ordemDaObra = new Map(porAno.flatMap((g) => g.obras).map((o, i) => [o.slug, i]));
const contagem = new Map<string, number>();
const maisNova = new Map<string, number>();
for (const obra of acervo) {
  for (const tag of obra.tags) {
    contagem.set(tag, (contagem.get(tag) ?? 0) + 1);
    const posicao = ordemDaObra.get(obra.slug) ?? Number.MAX_SAFE_INTEGER;
    if (posicao < (maisNova.get(tag) ?? Number.MAX_SAFE_INTEGER)) maisNova.set(tag, posicao);
  }
}
const tags = [...contagem.entries()].sort(
  (a, b) => b[1] - a[1] || maisNova.get(a[0])! - maisNova.get(b[0])! || a[0].localeCompare(b[0])
);

/**
 * Quantas ficam à vista. A ordenação acima já pôs as mais usadas na frente,
 * então o corte cai sempre nas mais raras, que são as que menos ajudam a
 * achar alguma coisa. Enquanto a lista inteira couber sem incomodar, ela sai
 * inteira: recolher duas etiquetas custa mais do que mostrar as duas.
 */
const cabemTodas = tags.length <= LIMITE_FILTROS + FOLGA_FILTROS;
const aVista = cabemTodas ? tags.length : LIMITE_FILTROS;
const recolhidas = tags.length - aVista;

/** A linha leva ao texto da obra, se houver. Senão, ao repositório dela. */
const destino = (slug: string, href?: string) => {
  const post = textos.get(slug);
  return post ? rota(lang, `/blog/${post}`) : href;
};
---

<Base lang={lang} titulo={titulo} descricao={descricao}>
  <Topo lang={lang} />

  <main id="conteudo">
    <section class="abertura wall hang">
      <div class="abertura-corpo">
        <h1 class="titulo-sala">{titulo}</h1>
        <p class="chamada linhas">
          {chamada.map((linha, i) => (<>{i > 0 && ' '}<span>{linha}</span></>))}
        </p>
      </div>
    </section>

    <section class="wall">
      <div class="filtro hang" data-filtro>
        <p class="field">{t('colecao.filtrar')}</p>
        <div>
          <div class="etiquetas">
            <button class="etiqueta etiqueta-ativa" type="button" data-tag="" aria-pressed="true">
              {t('colecao.todas')} <span class="etiqueta-n">{acervo.length}</span>
            </button>
            {
              tags.map(([tag, n], i) => (
                <button
                  class="etiqueta"
                  type="button"
                  data-tag={tag}
                  aria-pressed="false"
                  hidden={i >= aVista}
                  data-recolhida={i >= aVista ? '' : undefined}
                >
                  {tagDe(tag, lang)} <span class="etiqueta-n">{n}</span>
                </button>
              ))
            }
            {
              recolhidas > 0 && (
                <button class="etiqueta etiqueta-mais" type="button" data-mais aria-expanded="false">
                  {t('filtro.mais')(recolhidas)}
                </button>
              )
            }
          </div>
          <p class="contagem" data-contagem>{t('colecao.contagem')(acervo.length, acervo.length)}</p>
        </div>
      </div>

      <div class="catalogo">
        {
          porAno.map(({ rotulo, relativo, obras, vivo, anoNumero }) => (
            <section class="grupo hang" data-grupo>
              <p class="ano">
                {rotulo}
                {relativo && (
                  <span class="ano-relativo" data-vivo={vivo} data-ano={anoNumero}>
                    {relativo}
                  </span>
                )}
              </p>
              <ul class="linhas">
                {obras.map((obra) => (
                  <li class="linha" data-tags={obra.tags.join(',')}>
                    <a class="linha-link" href={destino(obra.slug, obra.link?.href)}>
                      <span class="dot dot-on" aria-hidden="true" />
                      <span class="linha-titulo">{obra.titulo}</span>
                      <span class="linha-meio">{meioDe(obra, lang)}</span>
                      <span class="linha-seta" aria-hidden="true">
                        &#8594;
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
        <p class="vazio" data-vazio hidden>{t('colecao.nada')}</p>
      </div>
    </section>
  </main>

  <Rodape lang={lang} />
</Base>

<!--
  O tempo se refaz no navegador.

  O site é estático: o que o build escreve é o número daquele dia. Sem isto,
  um canal que continua rodando ficaria parado em "4 anos e 8 meses" até o
  próximo deploy, e em 1º de janeiro a coleção ainda diria que o ano anterior
  é "este ano". O servidor entrega o texto certo para quem chega sem
  JavaScript e para o buscador; o navegador só corrige se o tempo passou.

  A conta usa o relógio de São Paulo, o mesmo fuso do resto do site.
-->
<script
  is:inline
  define:vars={{
    fuso: 'America/Sao_Paulo',
    localeData: LOCALE_DATA[lang],
    rotulos: ROTULOS_DURACAO[lang],
  }}
>
  (function () {
    var MS_DIA = 86400000;
    var MS_MES = 30.436875 * MS_DIA;
    var MS_ANO = 365.2425 * MS_DIA;

    function plural(n, um, muitos) {
      return n + ' ' + (n === 1 ? um : muitos);
    }

    /** Mesma regra do `duracao` em src/lib/tempo.ts. As duas precisam bater. */
    function duracao(inicio, agora) {
      var ms = Math.max(0, agora - inicio);
      var anos = Math.floor(ms / MS_ANO);
      var meses = Math.floor((ms - anos * MS_ANO) / MS_MES);
      if (anos >= 1) {
        var parte = plural(anos, rotulos.ano, rotulos.anos);
        return meses === 0 ? parte : parte + ' ' + rotulos.e + ' ' + plural(meses, rotulos.mes, rotulos.meses);
      }
      var m = Math.floor(ms / MS_MES);
      if (m >= 1) return plural(m, rotulos.mes, rotulos.meses);
      return plural(Math.max(1, Math.floor(ms / MS_DIA)), rotulos.dia, rotulos.dias);
    }

    /** O ano corrente em São Paulo, não o do relógio de quem visita. */
    function anoAqui() {
      return Number(
        new Intl.DateTimeFormat('en-CA', { year: 'numeric', timeZone: fuso }).format(new Date())
      );
    }

    var agora = Date.now();

    document.querySelectorAll('.ano-relativo').forEach(function (el) {
      var vivo = el.getAttribute('data-vivo');
      if (vivo) {
        el.textContent = duracao(new Date(vivo).getTime(), agora);
        return;
      }
      var ano = el.getAttribute('data-ano');
      if (ano) {
        try {
          var fmt = new Intl.RelativeTimeFormat(localeData, { numeric: 'auto' });
          el.textContent = fmt.format(Number(ano) - anoAqui(), 'year');
        } catch (e) {}
      }
    });
  })();
</script>

<script
  is:inline
  define:vars={{
    textoContagem: { um: t('colecao.contagem')(1, 2).replace(/\d+/g, '#') },
    rotuloMais: recolhidas > 0 ? t('filtro.mais')(recolhidas) : '',
    rotuloMenos: t('filtro.menos'),
  }}
>
  (function () {
    var filtro = document.querySelector('[data-filtro]');
    if (!filtro) return;
    // Só os que filtram de verdade. O botão que abre o resto também tem a
    // classe `etiqueta`, porque é o mesmo objeto de vidro na parede, mas ele
    // não é um filtro e não pode entrar nesta lista.
    var botoes = filtro.querySelectorAll('.etiqueta[data-tag]');
    var linhas = document.querySelectorAll('.linha');
    var grupos = document.querySelectorAll('[data-grupo]');
    var contagem = document.querySelector('[data-contagem]');
    var vazio = document.querySelector('[data-vazio]');
    var total = linhas.length;
    var molde = contagem ? contagem.textContent : '';

    function aplicar(tag) {
      var visiveis = 0;
      linhas.forEach(function (linha) {
        var tags = (linha.getAttribute('data-tags') || '').split(',');
        var mostra = !tag || tags.indexOf(tag) !== -1;
        linha.hidden = !mostra;
        if (mostra) visiveis++;
      });

      // Ano sem nenhuma obra visível some junto, senão sobra rótulo solto.
      grupos.forEach(function (grupo) {
        var algum = grupo.querySelectorAll('.linha:not([hidden])').length > 0;
        grupo.hidden = !algum;
      });

      if (contagem) {
        contagem.textContent =
          visiveis === total ? molde : molde.replace(String(total), visiveis + ' / ' + total);
      }
      if (vazio) vazio.hidden = visiveis > 0;

      botoes.forEach(function (b) {
        var ativo = (b.getAttribute('data-tag') || '') === tag;
        b.classList.toggle('etiqueta-ativa', ativo);
        b.setAttribute('aria-pressed', String(ativo));
      });
    }

    botoes.forEach(function (b) {
      b.addEventListener('click', function () {
        var tag = b.getAttribute('data-tag') || '';
        // Clicar de novo na etiqueta ativa desliga o filtro.
        aplicar(b.classList.contains('etiqueta-ativa') ? '' : tag);
      });
    });

    /* As etiquetas raras, e o botão que as chama.
       Recolher nunca esconde a etiqueta que está filtrando a página: sumir
       com o filtro em uso deixaria a lista curta sem explicação na tela. */
    var mais = filtro.querySelector('[data-mais]');
    if (!mais) return;
    var recolhiveis = filtro.querySelectorAll('[data-recolhida]');
    var aberto = false;

    mais.addEventListener('click', function () {
      aberto = !aberto;
      recolhiveis.forEach(function (b) {
        b.hidden = !aberto && !b.classList.contains('etiqueta-ativa');
      });
      mais.textContent = aberto ? rotuloMenos : rotuloMais;
      mais.setAttribute('aria-expanded', String(aberto));
    });
  })();
</script>

<style>
  .abertura {
    padding-block: clamp(3rem, 10vh, 6rem) clamp(2rem, 6vh, 3.5rem);
  }

  .abertura-corpo {
    grid-column: 2 / -1;
  }

  @media (max-width: 47.99rem) {
    .abertura-corpo {
      grid-column: 1 / -1;
    }
  }

  .titulo-sala {
    font-size: clamp(2rem, 1.2rem + 3vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .chamada {
    margin-top: 1rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  /* A quebra vem da classe `linhas`. A medida acompanha a linha mais longa
     dos três idiomas, senão ela dobraria e desfaria a quebra no desktop. */
  .chamada span {
    max-width: 68ch;
  }

  /* Filtro ------------------------------------------------------- */

  .filtro {
    padding-block: 0 1.75rem;
    border-bottom: 1px solid var(--color-rule);
    row-gap: 0.75rem;
  }

  .etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .etiqueta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    background: none;
    border: 1px solid var(--color-rule);
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.75rem;
    color: var(--color-ink-soft);
    transition:
      border-color 180ms ease,
      color 180ms ease,
      background-color 180ms ease;
  }

  .etiqueta:hover {
    border-color: var(--color-ink-soft);
    color: var(--color-ink);
  }

  /* Sem isto o `hidden` não esconde nada: o atributo vale `display: none` na
     folha do navegador, e qualquer `display` escrito aqui ganha dele. */
  .etiqueta[hidden] {
    display: none;
  }

  .etiqueta-ativa {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-wall);
  }

  /* Não é etiqueta de assunto, é a chave que abre a gaveta. Sem moldura, para
     não ser confundida com um filtro a mais. */
  .etiqueta-mais {
    border-color: transparent;
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-underline-offset: 0.25em;
  }

  .etiqueta-mais:hover {
    border-color: transparent;
    text-decoration-color: var(--color-ink);
  }

  .etiqueta-n {
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
  }

  .contagem {
    margin-top: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* Catálogo ----------------------------------------------------- */

  .grupo {
    padding-block: 2rem 0.5rem;
  }

  /* O último grupo encostava no fio do rodapé, a 8px, e aquele fio é mais
     largo e começa mais à esquerda que tudo no catálogo, então destoava.
     Agora o catálogo fecha com um fio da mesma medida do que o abre, embaixo
     do filtro, e só depois vem o espaço até o rodapé. */
  .catalogo {
    border-bottom: 1px solid var(--color-rule);
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }

  /* Sem isto seriam dois fios quase colados: o da última obra e o de baixo. */
  .grupo:last-of-type .linha:last-of-type .linha-link {
    border-bottom: 0;
  }

  .grupo[hidden] {
    display: none;
  }

  /* O ano na margem é a espinha cronológica da página. */
  .ano {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
    padding-top: 0.85rem;
  }

  .ano-relativo {
    display: block;
    margin-top: 0.2rem;
    font-weight: 400;
    font-size: 0.75rem;
    opacity: 0.75;
  }

  .linhas {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .linha[hidden] {
    display: none;
  }

  /* A linha inteira é clicável: alvo grande, sem caça ao link. */
  .linha-link {
    display: grid;
    grid-template-columns: 0.75rem minmax(0, 1fr) auto 1.25rem;
    align-items: baseline;
    gap: 0 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--color-rule);
    color: inherit;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .linha-link:hover {
    background-color: var(--color-paper);
  }

  .linha-link:hover .linha-seta {
    opacity: 1;
    transform: translateX(2px);
  }

  .linha-titulo {
    font-family: var(--font-work);
    font-style: italic;
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .linha-meio {
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
    text-align: right;
  }


  .linha-seta {
    font-size: 0.875rem;
    color: var(--color-ink-soft);
    opacity: 0;
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  @media (max-width: 47.99rem) {
    .linha-link {
      grid-template-columns: 0.75rem minmax(0, 1fr);
      row-gap: 0.25rem;
    }

    .linha-meio {
      grid-column: 2;
      text-align: left;
    }

    .linha-seta {
      display: none;
    }
  }

  .vazio {
    padding-block: 3rem;
    color: var(--color-ink-soft);
    font-size: 1rem;
  }
</style>
