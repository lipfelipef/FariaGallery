---
import Base from '../layouts/Base.astro';
import Etiqueta from '../components/Etiqueta.astro';
import { OBRAS, type Obra } from '../data/obras';
import { SITE, SOCIAL } from '../consts';

/**
 * Obra sem ficha preenchida não vai pra parede. Some do site inteiro
 * enquanto estiver marcada como `pendente`, e volta quando o campo sai.
 */
const emCartaz = OBRAS.filter((o) => !o.pendente);
const comCodigo = emCartaz.filter((o) => o.estado === 'publico').length;

const canal: Obra = {
  titulo: 'Até Zerar',
  ano: 'a definir',
  resumo: 'A definir: sobre o que é o canal e com que frequência sai vídeo.',
  meio: 'Vídeo',
  papel: 'a definir',
  credito: 'a definir',
  estado: 'noar',
  link: { href: SOCIAL.youtube, texto: 'Ver o canal' },
  pendente: true,
};

const descricao =
  'Felipe Faria, desenvolvedor e estudante de Análise e Desenvolvimento de Sistemas no Senac São Paulo. Coleção de projetos com a ficha inteira: do que são feitos, qual foi meu papel e em que estado estão.';
---

<Base descricao={descricao}>
  <header class="topo wall">
    <a class="marca" href="/">{SITE.brand}</a>
    <nav aria-label="Seções desta página">
      <ul class="menu">
        <li><a class="quiet-link" href="#obras">Obras</a></li>
        {!canal.pendente && <li><a class="quiet-link" href="#canal">Canal</a></li>}
      </ul>
    </nav>
  </header>

  <main id="conteudo">
    <!-- Parede de entrada: no museu é o texto que abre a exposição. -->
    <section class="entrada wall hang">
      <div class="entrada-corpo entrance">
        <h1 class="nome">{SITE.name}</h1>

        <p class="linha-artista">
          Brasileiro, n. 2006. Análise e Desenvolvimento de Sistemas, Senac São
          Paulo.
        </p>

        <div class="texto-parede">
          <p>
            Aqui fica o registro do que eu construo. Cada obra vem com a ficha
            inteira: do que é feita, qual foi meu papel, com quem foi e em que
            estado está.
          </p>
          <p>
            O que não deu certo entra com a mesma ficha, porque projeto que
            parou também tem o que ensinar.
          </p>
        </div>

        <p class="acervo">
          {emCartaz.length} obras na coleção. {comCodigo} com código público.
        </p>
      </div>
    </section>

    <section id="obras" class="sala wall">
      <h2 class="sala-titulo">Obras</h2>
      <div class="sala-corpo">
        {emCartaz.map((obra) => <Etiqueta obra={obra} />)}
      </div>
    </section>

    {
      !canal.pendente && (
        <section id="canal" class="sala wall">
          <h2 class="sala-titulo">Canal</h2>
          <div class="sala-corpo">
            <Etiqueta obra={canal} />
          </div>
        </section>
      )
    }
  </main>

  <footer class="rodape wall hang">
    <p class="field">Onde me achar</p>
    <div class="rodape-corpo">
      <ul class="rodape-links">
        <li>
          <a class="quiet-link" href={SOCIAL.github} rel="me noopener noreferrer" target="_blank">
            Felipe Faria no GitHub
          </a>
        </li>
        <li>
          <a class="quiet-link" href={SOCIAL.linkedin} rel="me noopener noreferrer" target="_blank">
            Felipe Faria no LinkedIn
          </a>
        </li>
        <li>
          <a class="quiet-link" href={SOCIAL.youtube} rel="me noopener noreferrer" target="_blank">
            Até Zerar no YouTube
          </a>
        </li>
      </ul>

      <p class="colofao">
        Feito em Astro. Composto em Archivo e EB Garamond. Sem cookie, sem
        rastreio e sem formulário.
      </p>
    </div>
  </footer>
</Base>

<style>
  /* Topo: a placa da instituição. Miúda, porque quem tem que aparecer
     grande é o nome dele, logo abaixo. */
  .topo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.75rem;
  }

  .marca,
  .menu {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .marca {
    color: var(--color-ink);
    text-decoration: none;
  }

  .menu {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--color-ink-soft);
  }

  /* Entrada ------------------------------------------------------- */

  .entrada {
    padding-block: clamp(4rem, 14vh, 9rem) clamp(4rem, 10vh, 7rem);
  }

  .entrada-corpo {
    grid-column: 2 / -1;
  }

  @media (max-width: 47.99rem) {
    .entrada-corpo {
      grid-column: 1 / -1;
    }
  }

  .nome {
    font-size: clamp(2.75rem, 1.4rem + 5.4vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .linha-artista {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
    max-width: 34ch;
  }

  .texto-parede {
    margin-top: 2.5rem;
    display: grid;
    gap: 1rem;
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .acervo {
    margin-top: 2.5rem;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* Salas --------------------------------------------------------- */

  .sala {
    padding-block: clamp(2rem, 5vh, 3.5rem) clamp(3rem, 8vh, 5rem);
  }

  /* O nome da sala é uma plaquinha, não um letreiro. Mesma tipografia
     dos campos da etiqueta, porque cumpre a mesma função. */
  .sala-titulo {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    padding-bottom: 1.25rem;
  }

  .sala-corpo {
    border-top: 1px solid var(--color-rule);
  }

  /* Rodapé -------------------------------------------------------- */

  .rodape {
    padding-block: clamp(3rem, 8vh, 5rem) clamp(4rem, 10vh, 6rem);
    border-top: 1px solid var(--color-rule);
  }

  .rodape-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.625rem;
    font-size: 0.9375rem;
  }

  .colofao {
    margin-top: 2rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 40ch;
  }

  @media (max-width: 47.99rem) {
    .rodape .field {
      margin-top: 0;
      margin-bottom: 1rem;
    }
  }
</style>
