---
import Base from '../layouts/Base.astro';
import Topo from '../components/Topo.astro';
import Rodape from '../components/Rodape.astro';
import Etiqueta from '../components/Etiqueta.astro';
import { OBRAS, CANAL } from '../data/obras';
import { SITE, SOCIAL, CONTACT_EMAIL, EMAIL_ATIVO } from '../consts';

const canais = [
  ...(EMAIL_ATIVO
    ? [{ campo: 'E-mail', texto: CONTACT_EMAIL, href: `mailto:${CONTACT_EMAIL}` }]
    : []),
  { campo: 'LinkedIn', texto: 'Felipe Faria', href: SOCIAL.linkedin },
  { campo: 'GitHub', texto: 'lipfelipef', href: SOCIAL.github },
  { campo: 'Canal', texto: 'Até Zerar', href: SOCIAL.youtube },
];

/**
 * Obra sem ficha preenchida não vai pra parede. Some do site inteiro
 * enquanto estiver marcada como `pendente`, e volta quando o campo sai.
 */
const emCartaz = OBRAS.filter((o) => !o.pendente);
const comCodigo = emCartaz.filter((o) => o.estado === 'publico').length;

const descricao =
  'Felipe Faria, desenvolvedor e estudante de Análise e Desenvolvimento de Sistemas no Senac São Paulo. Coleção de projetos com a ficha inteira: do que são feitos, qual foi meu papel e em que estado estão.';
---

<Base descricao={descricao}>
  <Topo naHome />

  <main id="conteudo">
    <!-- Parede de entrada: no museu é o texto que abre a exposição. -->
    <section class="entrada wall hang">
      <div class="entrada-corpo entrance">
        <h1 class="nome">{SITE.name}</h1>

        <p class="linha-artista">
          Brasileiro, n. 2006. Análise e Desenvolvimento de Sistemas, Senac São
          Paulo.
        </p>

        <div class="texto-parede">
          <p>
            Aqui fica o registro do que eu construo. Cada obra vem com a ficha
            inteira: do que é feita, qual foi meu papel, com quem foi e em que
            estado está.
          </p>
          <p>
            O que não deu certo entra com a mesma ficha, porque projeto que
            parou também tem o que ensinar.
          </p>
        </div>

        <p class="acervo">
          {emCartaz.length} obras na coleção. {comCodigo} com código público.
        </p>
      </div>
    </section>

    <section id="obras" class="sala wall">
      <h2 class="sala-titulo">Obras</h2>
      <div class="sala-corpo">
        {emCartaz.map((obra) => <Etiqueta obra={obra} />)}
      </div>
    </section>

    {
      !CANAL.pendente && (
        <section id="canal" class="sala wall">
          <h2 class="sala-titulo">Canal</h2>
          <div class="sala-corpo">
            <Etiqueta obra={CANAL} />
          </div>
        </section>
      )
    }

    <section id="contato" class="sala wall">
      <h2 class="sala-titulo">Contato</h2>
      <div class="sala-corpo">
        <dl class="canais hang">
          {
            canais.map(({ campo, texto, href }) => (
              <>
                <dt class="field">{campo}</dt>
                <dd class="value">
                  <a
                    class="quiet-link"
                    href={href}
                    rel={href.startsWith('mailto:') ? undefined : 'me noopener noreferrer'}
                    target={href.startsWith('mailto:') ? undefined : '_blank'}
                  >
                    {texto}
                  </a>
                </dd>
              </>
            ))
          }
        </dl>
      </div>
    </section>
  </main>

  <Rodape />
</Base>

<style>
  .entrada {
    padding-block: clamp(4rem, 14vh, 9rem) clamp(4rem, 10vh, 7rem);
  }

  .entrada-corpo {
    grid-column: 2 / -1;
  }

  @media (max-width: 47.99rem) {
    .entrada-corpo {
      grid-column: 1 / -1;
    }
  }

  .nome {
    font-size: clamp(2.75rem, 1.4rem + 5.4vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .linha-artista {
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
    max-width: 34ch;
  }

  .texto-parede {
    margin-top: 2.5rem;
    display: grid;
    gap: 1rem;
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .acervo {
    margin-top: 2.5rem;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .sala {
    padding-block: clamp(2rem, 5vh, 3.5rem) clamp(3rem, 8vh, 5rem);
  }

  /* O nome da sala é uma plaquinha, não um letreiro. Mesma tipografia
     dos campos da etiqueta, porque cumpre a mesma função. */
  .sala-titulo {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    padding-bottom: 1.25rem;
  }

  .sala-corpo {
    border-top: 1px solid var(--color-rule);
  }

  .canais {
    padding-block: clamp(2rem, 4vw, 3rem);
    row-gap: 0.75rem;
  }

  @media (max-width: 47.99rem) {
    .canais {
      row-gap: 0.125rem;
    }
  }
</style>
