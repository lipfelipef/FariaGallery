---
import Base from '../layouts/Base.astro';
import Topo from '../components/Topo.astro';
import Rodape from '../components/Rodape.astro';
import { traduzir } from '../i18n/ui';
import { rota } from '../i18n/utils';

/**
 * Uma página só, em português, porque o Cloudflare serve o mesmo 404 para
 * qualquer caminho e não dá para saber o idioma de um endereço que não existe.
 * Os três caminhos de volta aparecem juntos, e cada um leva para o idioma dele.
 */
const t = traduzir('pt');
---

<Base lang="pt" titulo={t('erro404.titulo')} descricao={t('erro404.texto')} semIndexar>
  <Topo lang="pt" />

  <main id="conteudo">
    <section class="erro wall hang">
      <p class="field">404</p>
      <div>
        <h1 class="titulo">{t('erro404.titulo')}</h1>
        <p class="texto">{t('erro404.texto')}</p>

        <ul class="saidas">
          <li><a class="quiet-link" href={rota('pt', '/')}>Início</a></li>
          <li><a class="quiet-link" href={rota('pt', '/obras')}>Coleção</a></li>
          <li><a class="quiet-link" href={rota('pt', '/blog')}>Blog</a></li>
          <li><a class="quiet-link" href={rota('pt', '/contato')}>Contato</a></li>
        </ul>
      </div>
    </section>
  </main>

  <Rodape lang="pt" />
</Base>

<style>
  .erro {
    padding-block: clamp(4rem, 14vh, 8rem) clamp(4rem, 12vh, 7rem);
    row-gap: 0.5rem;
  }

  .titulo {
    font-family: var(--font-work);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.875rem, 1.2rem + 2.6vw, 3rem);
    line-height: 1.05;
  }

  .texto {
    margin-top: 1rem;
    max-width: 44ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .saidas {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    font-size: 0.9375rem;
  }
</style>
