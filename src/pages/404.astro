---
import Base from '../layouts/Base.astro';
import Topo from '../components/Topo.astro';
import Rodape from '../components/Rodape.astro';
import { traduzir, UI } from '../i18n/ui';
import { LANG_HTML, rota } from '../i18n/utils';
import { LOCALES } from '../consts';

/**
 * Uma página só, e ela vem em português.
 *
 * O Cloudflare serve este mesmo arquivo para qualquer endereço que não exista,
 * inclusive `/en/qualquercoisa`. O servidor não escolhe o idioma porque não há
 * o que escolher: é um arquivo estático para todos os erros do site.
 *
 * O que dá para fazer, e é o que o script no fim faz, é olhar no navegador o
 * endereço que a pessoa realmente tentou abrir. Quem errou dentro de `/en/`
 * estava lendo em inglês e recebe o texto em inglês.
 */
const t = traduzir('pt');

/** Os mesmos textos nos três idiomas, para o script escolher no navegador. */
const traducoes = Object.fromEntries(
  LOCALES.map((lang) => [
    lang,
    {
      lang: LANG_HTML[lang],
      titulo: UI[lang]['erro404.titulo'],
      texto: UI[lang]['erro404.texto'],
      saidas: [
        { rotulo: UI[lang]['nav.inicio'], href: rota(lang, '/') },
        { rotulo: UI[lang]['nav.colecao'], href: rota(lang, '/obras') },
        { rotulo: UI[lang]['nav.blog'], href: rota(lang, '/blog') },
        { rotulo: UI[lang]['nav.contato'], href: rota(lang, '/contato') },
      ],
    },
  ])
);
---

<Base lang="pt" titulo={t('erro404.titulo')} descricao={t('erro404.texto')} semIndexar>
  <Topo lang="pt" />

  <main id="conteudo">
    <section class="erro wall hang">
      <p class="field">404</p>
      <div>
        <h1 class="titulo" data-titulo>{t('erro404.titulo')}</h1>
        <p class="texto" data-texto>{t('erro404.texto')}</p>

        <ul class="saidas" data-saidas>
          <li><a class="quiet-link" href={rota('pt', '/')}>{t('nav.inicio')}</a></li>
          <li><a class="quiet-link" href={rota('pt', '/obras')}>{t('nav.colecao')}</a></li>
          <li><a class="quiet-link" href={rota('pt', '/blog')}>{t('nav.blog')}</a></li>
          <li><a class="quiet-link" href={rota('pt', '/contato')}>{t('nav.contato')}</a></li>
        </ul>
      </div>
    </section>
  </main>

  <Rodape lang="pt" />
</Base>

<!--
  Quem errou o endereço em inglês lê o erro em inglês.

  O servidor entrega esta página em português para todo endereço que não
  existe, porque é um arquivo só e ele não sabe de nada. Mas o navegador sabe:
  o endereço que a pessoa tentou abrir está ali na barra. Se ele começa com
  `/en/` ou `/es/`, ela estava lendo naquele idioma e o texto troca.

  Só troca quando reconhece o prefixo. Endereço solto como `/4324` não diz
  idioma nenhum, e nesse caso o português da casa fica.
-->
<script is:inline define:vars={{ traducoes }}>
  (function () {
    var primeiro = location.pathname.split('/').filter(Boolean)[0];
    var t = traducoes[primeiro];
    if (!t) return;

    document.documentElement.lang = t.lang;
    document.title = t.titulo + document.title.slice(document.title.indexOf(' | '));
    document.querySelector('[data-titulo]').textContent = t.titulo;
    document.querySelector('[data-texto]').textContent = t.texto;

    var itens = document.querySelectorAll('[data-saidas] a');
    t.saidas.forEach(function (saida, i) {
      if (!itens[i]) return;
      itens[i].textContent = saida.rotulo;
      itens[i].setAttribute('href', saida.href);
    });
  })();
</script>

<style>
  .erro {
    padding-block: clamp(4rem, 14vh, 8rem) clamp(4rem, 12vh, 7rem);
    row-gap: 0.5rem;
  }

  .titulo {
    font-family: var(--font-work);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.875rem, 1.2rem + 2.6vw, 3rem);
    line-height: 1.05;
  }

  .texto {
    margin-top: 1rem;
    max-width: 44ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .saidas {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    font-size: 0.9375rem;
  }
</style>
