---
import Estudo from '../../components/Estudo.astro';
import { obraPorSlug, type Obra } from '../../data/obras';
import { estudosPublicados, type Estudo as TipoEstudo } from '../../lib/estudos';

/** Só existe página para obra que tem estudo escrito. Sem texto, sem página. */
export async function getStaticPaths() {
  const estudos = await estudosPublicados('pt');
  return estudos
    .map((estudo) => {
      const obra = obraPorSlug(estudo.data.obra);
      return obra ? { params: { slug: obra.slug }, props: { estudo, obra } } : null;
    })
    .filter((x): x is NonNullable<typeof x> => x !== null);
}

interface Props {
  estudo: TipoEstudo;
  obra: Obra;
}

const { estudo, obra } = Astro.props;
---

<Estudo estudo={estudo} obra={obra} lang="pt" />
