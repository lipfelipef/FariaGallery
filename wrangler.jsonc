{
  // Diz ao Cloudflare Workers o que publicar.
  // Site 100% estático: não existe campo "main" porque não há código de
  // servidor, só a pasta que o `astro build` gera.
  "name": "fariagallery",
  "compatibility_date": "2026-08-07",

  // O site atende só em fariagallery.com. Sem isto, a Cloudflare também publica
  // em fariagallery.<subdominio>.workers.dev, um endereço que expõe o nome de
  // usuário da conta e serve uma cópia do site inteira fora do domínio próprio.
  "workers_dev": false,
  // Mesma razão, para as URLs geradas a cada versão publicada.
  "preview_urls": false,

  "assets": {
    "directory": "./dist",

    // Sem isto, endereco que nao existe devolve 404 de corpo vazio e quem
    // visita ve a tela de erro do proprio navegador, fora do site. Com
    // "404-page" a Cloudflare procura o 404.html mais proximo na pasta e o
    // entrega com status 404, que e o certo: a pessoa continua dentro da
    // galeria e o buscador continua sabendo que aquele endereco nao existe.
    //
    // Mandar para a home seria pior. O buscador chama isso de soft 404:
    // responder 200 para pagina que nao existe faz ele indexar copia da home
    // em endereco inventado, e quem errou de digitar nem descobre o erro.
    // O padrao e "none", que responde 404 sem corpo nenhum: e dai que vinha a
    // tela de erro do navegador.
    "not_found_handling": "404-page"
  }
}
