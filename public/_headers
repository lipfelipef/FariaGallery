# Cabecalhos de seguranca de fariagallery.com
#
# Site 100% estatico: sem back-end, sem banco, sem formulario, sem login e sem
# nada que aceite entrada de quem visita. A superficie de ataque ja e pequena,
# mas cabecalho de seguranca custa zero e fecha a porta antes de alguem tentar.
#
# A Cloudflare ja manda por conta dela `X-Content-Type-Options: nosniff` e o
# `Strict-Transport-Security`, entao esses dois nao se repetem aqui.
#
# Este arquivo nao vai para o site: a Cloudflare le e aplica, e o endereco
# /_headers nao existe para quem visita.

/*
  # Impede que qualquer site coloque a galeria dentro de um iframe e use a
  # pagina como isca de clique. O `frame-ancestors` da CSP abaixo faz o mesmo
  # para navegador novo; este aqui atende os antigos.
  X-Frame-Options: DENY

  # Sai so a origem quando o link leva para fora, nunca o caminho. O GitHub
  # sabe que a visita veio de fariagallery.com e nao fica sabendo qual texto
  # a pessoa estava lendo.
  Referrer-Policy: strict-origin-when-cross-origin

  # Desliga o que o site nao usa. Sem isto, o navegador so pergunta na hora;
  # com isto, nem pergunta, porque nada aqui tem motivo para pedir camera,
  # microfone, localizacao ou pagamento.
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()

  # Janela aberta por este site fica isolada da que abriu. Vale para os links
  # de GitHub, YouTube, LinkedIn e Instagram do rodape e das fichas.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

  # Fecha tudo por padrao e abre so o que o site usa de verdade.
  #
  #   default-src 'self'    nada de fora, salvo o que estiver liberado abaixo
  #   script-src            o beacon do Web Analytics da Cloudflare e servido
  #                         de static.cloudflareinsights.com e e injetado no
  #                         HTML pela propria Cloudflare, entao precisa constar
  #                         aqui, senao a medicao de visitas para de funcionar
  #   'unsafe-inline'       o site tem scripts escritos direto na pagina (o
  #                         tema, o filtro das etiquetas, o tempo que se
  #                         refaz). Eles rodam antes da pagina pintar e por
  #                         isso nao podem virar arquivo separado. Como nao ha
  #                         entrada de usuario em lugar nenhum, nao existe
  #                         texto de terceiro que pudesse virar script aqui
  #   connect-src           para onde o beacon manda a medicao
  #   object-src 'none'     nada de plugin, Flash ou <embed>
  #   base-uri 'none'       ninguem reescreve a base dos links relativos
  #   form-action 'none'    nao existe formulario no site, entao nada pode
  #                         enviar dado para lugar nenhum
  #   frame-src 'none'      nenhuma pagina de terceiro roda embutida aqui
  #   frame-ancestors 'none'  e esta pagina nao roda embutida em lugar nenhum
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# O security.txt precisa ser lido como texto puro por quem for reportar um
# problema, e nao baixado como arquivo desconhecido.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
